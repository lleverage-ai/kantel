#!/usr/bin/env bash
# seed-op: run one seeding method once and print one JSON line of phase timings.
# Runs unchanged on a self-hosted Docker node and inside a Cloudflare Container.
#
#   seed-op <method> key=value...
#
# Common keys: repo, sha, mirror (bare mirror path), dst (target dir),
# sparse (space-separated cone paths), lower (prepared checkout dir),
# sqsh (squashfs image), archive (deps tar.zst path or http URL), run (run id).
set -euo pipefail

method="$1"; shift
declare -A a=()
for kv in "$@"; do a["${kv%%=*}"]="${kv#*=}"; done
repo="${a[repo]:-}"; sha="${a[sha]:-}"; mirror="${a[mirror]:-}"; dst="${a[dst]:-/workspace/w}"
sparse="${a[sparse]:-}"; lower="${a[lower]:-}"; sqsh="${a[sqsh]:-}"; archive="${a[archive]:-}"

now() { date +%s%N; }
declare -a phases=()
t0=$(now); tp=$t0
mark() { local t; t=$(now); phases+=("\"$1\":$(( (t - tp) / 1000000 ))"); tp=$t; }

files_count() { git -C "$1" ls-files | wc -l; }
# stat=minimal makes git trust only whole-second mtime and size, so an index written on another
# filesystem (overlay lower, squashfs, snapshot, extracted backup) does not force a full rehash.
statcfg=()
[[ "${a[stat]:-}" == minimal ]] && statcfg=(-c core.checkStat=minimal -c core.trustctime=false)
first_status() { git "${statcfg[@]}" -C "$1" status --porcelain=v1 >/dev/null; }

extra=""
case "$method" in
  noop)
    ;;
  worktree)
    # Warm bare mirror + git worktree add (needs write access to the mirror's admin dir).
    git -C "$mirror" worktree add -q --detach "$dst" "$sha"; mark checkout
    first_status "$dst"; mark status
    ;;
  ref-full)
    # Full clone that borrows every object from the mirror through alternates (read-only mirror).
    git clone -q --no-checkout --reference "$mirror" "file://$mirror" "$dst"; mark clone
    git -C "$dst" checkout -q --detach "$sha"; mark checkout
    first_status "$dst"; mark status
    ;;
  ref-sparse)
    # Blobless sparse clone with --reference to the mirror: only the cone is checked out.
    git clone -q --no-checkout --filter=blob:none --sparse --reference "$mirror" "file://$mirror" "$dst"; mark clone
    # shellcheck disable=SC2086
    git -C "$dst" sparse-checkout set --cone $sparse; mark sparse
    git -C "$dst" checkout -q --detach "$sha"; mark checkout
    first_status "$dst"; mark status
    ;;
  github-sparse)
    # Baseline: no mirror. Blobless sparse clone straight from GitHub (network bound).
    git clone -q --no-checkout --filter=blob:none --sparse "${a[url]}" "$dst"; mark clone
    # shellcheck disable=SC2086
    git -C "$dst" sparse-checkout set --cone $sparse; mark sparse
    git -C "$dst" checkout -q --detach "$sha"; mark checkout
    first_status "$dst"; mark status
    ;;
  overlay)
    # Prepared checkout (with node_modules) as a read-only overlayfs lower layer, per-session upper on tmpfs.
    mkdir -p /run/ov && mount -t tmpfs tmpfs /run/ov && mkdir -p /run/ov/up /run/ov/wk "$dst"
    mount -t overlay overlay -o "lowerdir=$lower,upperdir=/run/ov/up,workdir=/run/ov/wk" "$dst"; mark mount
    first_status "$dst"; mark status
    ;;
  fuse-overlay)
    # Same as overlay but through fuse-overlayfs (what you get without kernel overlay permissions).
    mkdir -p /run/ov && mount -t tmpfs tmpfs /run/ov && mkdir -p /run/ov/up /run/ov/wk "$dst"
    fuse-overlayfs -o "lowerdir=$lower,upperdir=/run/ov/up,workdir=/run/ov/wk" "$dst"; mark mount
    first_status "$dst"; mark status
    ;;
  squashfs)
    # SquashFS image of the prepared checkout, mounted read-only and overlaid (Sandbox 0.x production restore shape).
    src="$sqsh"
    if [[ "$src" == http* ]]; then curl -fsS -o /run/seed.sqsh "$src"; src=/run/seed.sqsh; mark fetch; fi
    mkdir -p /run/sq /run/ov && mount -t tmpfs tmpfs /run/ov && mkdir -p /run/ov/up /run/ov/wk "$dst"
    squashfuse "$src" /run/sq; mark squashmount
    fuse-overlayfs -o "lowerdir=/run/sq,upperdir=/run/ov/up,workdir=/run/ov/wk" "$dst"; mark mount
    first_status "$dst"; mark status
    ;;
  deps-archive)
    # Prebuilt node_modules archive keyed by lockfile hash, extracted into an existing checkout.
    src="$archive"
    if [[ "$src" == http* ]]; then curl -fsS -o /run/deps.tar.zst "$src"; src=/run/deps.tar.zst; mark fetch; fi
    mkdir -p "$dst"
    zstd -q -d -T0 -c "$src" | tar -x -C "$dst"; mark extract
    ;;
  deps-archive-stream)
    # Same, streamed straight from object storage into tar (no temp file).
    mkdir -p "$dst"
    curl -fsS "$archive" | zstd -q -d -T0 -c | tar -x -C "$dst"; mark extract
    ;;
  status)
    first_status "$dst"; mark status
    ;;
  *)
    echo "unknown method $method" >&2; exit 2;;
esac

t1=$(now)
if [[ "${a[count]:-0}" == 1 ]]; then extra=",\"files\":$(files_count "$dst" 2>/dev/null || echo 0)"; fi
IFS=,; echo "{\"method\":\"$method\",\"repo\":\"$repo\",\"run\":\"${a[run]:-}\",\"op_ms\":$(( (t1 - t0) / 1000000 )),\"phases\":{${phases[*]}}$extra}"
