{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"types": ["node"]
	},
	"include": [
		"packages/*/src/**/*.ts",
		"packages/*/test/**/*.ts",
		"packages/*/generated/**/*.ts",
		"images/isolate-host/src/pool.ts",
		"images/isolate-host/test/**/*.ts",
		"tools/base-images/**/*.ts",
		"vitest.config.ts",
		"docs/site/scripts/*.ts"
	],
	"exclude": ["packages/ui"]
}
