{
	"name": "@harbour/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Harbour's shared React component library: tokens, primitives and session components, in T3 Code's style",
	"license": "Apache-2.0",
	"sideEffects": [
		"**/*.css",
		"./src/index.ts"
	],
	"exports": {
		".": "./src/index.ts",
		"./tokens.css": "./src/tokens/tokens.css",
		"./tokens": "./src/tokens/tokens.ts",
		"./vault/fixtures": "./src/vault/fixtures.ts",
		"./audit/fixtures": "./src/audit/fixtures.ts",
		"./schedules/fixtures": "./src/schedules/fixtures.ts",
		"./skills/fixtures": "./src/skills/fixtures.ts",
		"./memory/fixtures": "./src/memory/fixtures.ts",
		"./workspace/image-fixture": "./src/workspace/image-fixture.ts",
		"./token-lint": "./scripts/token-lint.ts"
	},
	"scripts": {
		"dev": "ladle serve",
		"build:workbench": "ladle build",
		"preview:workbench": "ladle preview",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"lint:tokens": "node scripts/token-lint.ts",
		"shoot": "node scripts/shoot.ts",
		"build:harness": "vite build --config loop/harness/vite.config.ts",
		"gates": "node loop/gates.ts",
		"measure": "node loop/measure.ts"
	},
	"peerDependencies": {
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0"
	},
	"devDependencies": {
		"@harbour/audit": "workspace:*",
		"@harbour/identity": "workspace:*",
		"@harbour/memory": "workspace:*",
		"@harbour/schedules": "workspace:*",
		"@harbour/skills": "workspace:*",
		"@ladle/react": "5.1.1",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"axe-core": "4.11.0",
		"playwright-core": "1.64.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@harbour/contracts": "workspace:*",
		"@harbour/protocol": "workspace:*",
		"@harbour/vault": "workspace:*",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"virtua": "0.53.6"
	}
}
