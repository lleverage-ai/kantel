{
	"name": "@kantel/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Kantel's shared React component library: tokens, primitives and the compute console, in T3 Code's style",
	"license": "Apache-2.0",
	"sideEffects": [
		"**/*.css",
		"./src/index.ts"
	],
	"exports": {
		".": "./src/index.ts",
		"./tokens.css": "./src/tokens/tokens.css",
		"./tokens": "./src/tokens/tokens.ts",
		"./theme-boot": "./src/theme/boot.ts",
		"./compute/fixtures": "./src/compute/fixtures.ts",
		"./token-lint": "./scripts/token-lint.ts"
	},
	"scripts": {
		"dev": "ladle serve",
		"build:workbench": "ladle build",
		"preview:workbench": "ladle preview",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"lint:tokens": "node scripts/token-lint.ts",
		"shoot": "node scripts/shoot.ts",
		"gates": "node loop/gates.ts"
	},
	"peerDependencies": {
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0"
	},
	"devDependencies": {
		"@kantel/identity": "workspace:*",
		"@ladle/react": "5.1.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"axe-core": "4.11.0",
		"playwright-core": "1.64.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@fontsource-variable/public-sans": "5.3.0",
		"@fontsource-variable/roboto-mono": "5.3.0",
		"@fontsource/abhaya-libre": "5.3.0",
		"@kantel/contracts": "workspace:*",
		"highlight.js": "11.12.0",
		"lucide-react": "1.64.0",
		"tailwindcss": "4.3.3"
	}
}
