{
	"openapi": "3.1.0",
	"info": {
		"title": "Harbour API",
		"version": "1",
		"description": "Harbour's public API for host apps, such as Lleverage, and for Harbour's own console, which uses it like any other client."
	},
	"servers": [
		{
			"url": "/v1"
		}
	],
	"security": [
		{
			"bearer": []
		}
	],
	"paths": {
		"/sessions": {
			"post": {
				"operationId": "createSession",
				"summary": "Create a session",
				"description": "Starts a session of an agent profile in a project, and sends it `message` when there is one. Needs the operator role on the project. If the first message is refused, the session is closed and the refusal answered.",
				"tags": ["sessions"],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateSessionBody"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "The new session.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/CreatedSession"
								}
							}
						}
					},
					"400": {
						"description": "`invalid`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"401": {
						"description": "The request needs a valid credential (`unauthenticated`).",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"403": {
						"description": "`forbidden`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"404": {
						"description": "`not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"422": {
						"description": "`refused`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					}
				}
			},
			"get": {
				"operationId": "listSessions",
				"summary": "List sessions",
				"description": "The sessions the caller may see, newest first, a page at a time.",
				"tags": ["sessions"],
				"parameters": [
					{
						"name": "projectId",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "agentId",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "status",
						"in": "query",
						"required": false,
						"schema": {
							"$ref": "#/components/schemas/SessionStatus"
						}
					},
					{
						"name": "parentSessionId",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "label",
						"in": "query",
						"required": false,
						"description": "Sessions with every one of these labels, each sent as `label.<key>=<value>`, such as `label.docketTask=TASK-3347`.",
						"schema": {
							"type": "object",
							"patternProperties": {
								"^.*$": {
									"type": "string"
								}
							}
						}
					},
					{
						"name": "limit",
						"in": "query",
						"required": false,
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 1000
						}
					},
					{
						"name": "cursor",
						"in": "query",
						"required": false,
						"description": "A previous page's `nextCursor`.",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "A page of sessions.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SessionPage"
								}
							}
						}
					},
					"400": {
						"description": "`invalid`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"401": {
						"description": "The request needs a valid credential (`unauthenticated`).",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"403": {
						"description": "`forbidden`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					}
				}
			}
		},
		"/sessions/{sessionId}": {
			"get": {
				"operationId": "getSession",
				"summary": "Get a session",
				"tags": ["sessions"],
				"parameters": [
					{
						"name": "sessionId",
						"in": "path",
						"required": true,
						"description": "The session's ID.",
						"schema": {
							"type": "string",
							"minLength": 1
						}
					}
				],
				"responses": {
					"200": {
						"description": "The session.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SessionRecord"
								}
							}
						}
					},
					"401": {
						"description": "The request needs a valid credential (`unauthenticated`).",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"403": {
						"description": "`forbidden`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"404": {
						"description": "`not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					}
				}
			}
		},
		"/sessions/{sessionId}/close": {
			"post": {
				"operationId": "closeSession",
				"summary": "Close a session",
				"description": "Ends the session for good: its sandbox leases, browser sessions and grants end. Closing a closed session does nothing.",
				"tags": ["sessions"],
				"parameters": [
					{
						"name": "sessionId",
						"in": "path",
						"required": true,
						"description": "The session's ID.",
						"schema": {
							"type": "string",
							"minLength": 1
						}
					}
				],
				"responses": {
					"204": {
						"description": "Closed."
					},
					"401": {
						"description": "The request needs a valid credential (`unauthenticated`).",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"403": {
						"description": "`forbidden`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"404": {
						"description": "`not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					}
				}
			}
		},
		"/sessions/{sessionId}/abort": {
			"post": {
				"operationId": "abortSession",
				"summary": "Abort a session's run",
				"description": "Stops what the session is doing now. The session stays open and takes new messages.",
				"tags": ["sessions"],
				"parameters": [
					{
						"name": "sessionId",
						"in": "path",
						"required": true,
						"description": "The session's ID.",
						"schema": {
							"type": "string",
							"minLength": 1
						}
					}
				],
				"requestBody": {
					"required": false,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/AbortSessionBody"
							}
						}
					}
				},
				"responses": {
					"204": {
						"description": "Aborted."
					},
					"400": {
						"description": "`invalid`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"401": {
						"description": "The request needs a valid credential (`unauthenticated`).",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"403": {
						"description": "`forbidden`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"404": {
						"description": "`not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"409": {
						"description": "`conflict`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					}
				}
			}
		},
		"/sessions/{sessionId}/messages": {
			"post": {
				"operationId": "sendMessage",
				"summary": "Send a message",
				"description": "Sends the session's agent a message, `via` a prompt, a steer or a follow-up. The answer arrives on the session's stream. Send an `Idempotency-Key` so a retry can't send it twice: a retry with the same key answers the first call's submission without sending anything, and one with another `via` is a `conflict`.",
				"tags": ["messages"],
				"parameters": [
					{
						"name": "sessionId",
						"in": "path",
						"required": true,
						"description": "The session's ID.",
						"schema": {
							"type": "string",
							"minLength": 1
						}
					},
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"description": "A key of your choosing, unique per call, such as a UUID. A retry with the same key gets the first call's answer and does nothing again.",
						"schema": {
							"type": "string",
							"minLength": 1,
							"maxLength": 255
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/MessageBody"
							}
						}
					}
				},
				"responses": {
					"202": {
						"description": "The session accepted the message.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Submission"
								}
							}
						}
					},
					"400": {
						"description": "`invalid`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"401": {
						"description": "The request needs a valid credential (`unauthenticated`).",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"403": {
						"description": "`forbidden`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"404": {
						"description": "`not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"409": {
						"description": "`conflict`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"422": {
						"description": "`refused`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					}
				}
			}
		},
		"/sessions/{sessionId}/stream": {
			"get": {
				"operationId": "streamSession",
				"summary": "Stream a session",
				"description": "The session as `@harbour/protocol` frames: `hello`, then a `snapshot` of its state and latest items (or, with `after`, the deltas after that cursor when the stream still holds them), then a `delta` for every change, live. Fold them with the protocol's `applyFrames`. Over a WebSocket, compressed where the platform can, or as server-sent events.",
				"tags": ["stream"],
				"parameters": [
					{
						"name": "sessionId",
						"in": "path",
						"required": true,
						"description": "The session's ID.",
						"schema": {
							"type": "string",
							"minLength": 1
						}
					},
					{
						"name": "after",
						"in": "query",
						"required": false,
						"description": "Resume after this cursor (a snapshot's or a delta's): the stream sends the deltas after it, or a snapshot when it no longer holds them.",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"101": {
						"description": "Upgraded to a WebSocket (send `Upgrade: websocket`). Each message is a JSON array of frames; an empty array is a keep-alive. The server negotiates `permessage-deflate` where the platform can. The client sends nothing; to resume, reconnect with `?after=` and the last cursor it holds.",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/ServerFrame"
									}
								}
							}
						}
					},
					"200": {
						"description": "The stream. Without an upgrade: server-sent events, each named after its frame's type with the frame as its JSON data, then one `ready` event once the client has caught up. Snapshot and delta events carry their cursor as the event ID, so `Last-Event-ID` resumes too.",
						"content": {
							"text/event-stream": {
								"schema": {
									"$ref": "#/components/schemas/ServerFrame"
								}
							}
						}
					},
					"400": {
						"description": "`invalid`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"401": {
						"description": "The request needs a valid credential (`unauthenticated`).",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"403": {
						"description": "`forbidden`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"404": {
						"description": "`not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					}
				}
			}
		},
		"/sessions/{sessionId}/history": {
			"get": {
				"operationId": "getSessionHistory",
				"summary": "Page back through a session",
				"description": "The session's transcript in pages, newest first, for scrolling back past a snapshot's items: start with `before` set to the snapshot's `items[0].id`, then follow `nextCursor`.",
				"tags": ["stream"],
				"parameters": [
					{
						"name": "sessionId",
						"in": "path",
						"required": true,
						"description": "The session's ID.",
						"schema": {
							"type": "string",
							"minLength": 1
						}
					},
					{
						"name": "cursor",
						"in": "query",
						"required": false,
						"description": "A previous page's `nextCursor`.",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "before",
						"in": "query",
						"required": false,
						"description": "Items older than this item ID, such as a snapshot's `items[0].id`.",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"required": false,
						"description": "At most this many items. Default 50, cut to 200.",
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					}
				],
				"responses": {
					"200": {
						"description": "One page of items.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SessionHistoryPage"
								}
							}
						}
					},
					"400": {
						"description": "`invalid`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"401": {
						"description": "The request needs a valid credential (`unauthenticated`).",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"403": {
						"description": "`forbidden`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"404": {
						"description": "`not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					},
					"501": {
						"description": "`not_supported`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorBody"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"securitySchemes": {
			"bearer": {
				"type": "http",
				"scheme": "bearer",
				"description": "A host app's API key (`hbr_…`), from the API keys page or `POST /v1/keys`. It acts as a `service` actor, limited to the key's projects and role. Behind Cloudflare Access a person's browser is signed in by Access instead, with no header."
			}
		},
		"schemas": {
			"AbortSessionBody": {
				"type": "object",
				"properties": {
					"reason": {
						"type": "string",
						"description": "Recorded in the audit trail."
					}
				},
				"title": "AbortSessionBody"
			},
			"Actor": {
				"anyOf": [
					{
						"type": "object",
						"required": ["kind", "userId"],
						"properties": {
							"kind": {
								"type": "string",
								"const": "human"
							},
							"userId": {
								"type": "string"
							}
						}
					},
					{
						"type": "object",
						"required": ["kind", "serviceId"],
						"properties": {
							"kind": {
								"type": "string",
								"const": "service"
							},
							"serviceId": {
								"type": "string"
							},
							"keyId": {
								"type": "string"
							}
						}
					},
					{
						"type": "object",
						"required": ["kind", "agentId", "sessionId"],
						"properties": {
							"kind": {
								"type": "string",
								"const": "agent"
							},
							"agentId": {
								"type": "string"
							},
							"sessionId": {
								"type": "string"
							}
						}
					},
					{
						"type": "object",
						"required": ["kind", "component"],
						"properties": {
							"kind": {
								"type": "string",
								"const": "system"
							},
							"component": {
								"type": "string"
							}
						}
					}
				],
				"title": "Actor",
				"description": "Who acted: a person, a host app's API key, an agent or Harbour itself."
			},
			"AssistantItem": {
				"type": "object",
				"required": ["kind", "id", "at", "text", "streaming"],
				"properties": {
					"kind": {
						"type": "string",
						"const": "assistant"
					},
					"id": {
						"type": "string"
					},
					"at": {
						"type": "integer",
						"description": "Epoch milliseconds, UTC."
					},
					"text": {
						"type": "string"
					},
					"streaming": {
						"type": "boolean",
						"description": "True while tokens are still arriving."
					},
					"thinking": {
						"type": "string"
					}
				},
				"title": "AssistantItem"
			},
			"Attention": {
				"anyOf": [
					{
						"type": "string",
						"const": "working"
					},
					{
						"type": "string",
						"const": "waiting"
					},
					{
						"type": "string",
						"const": "done"
					}
				],
				"title": "Attention",
				"description": "How a session list groups the session: working, waiting on someone, or done."
			},
			"BrowserGrantCard": {
				"type": "object",
				"required": ["type", "requestId", "reason", "status"],
				"properties": {
					"type": {
						"type": "string",
						"const": "browser.grant"
					},
					"requestId": {
						"type": "string"
					},
					"reason": {
						"type": "string"
					},
					"status": {
						"anyOf": [
							{
								"type": "string",
