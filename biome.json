{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/coverage",
			"!**/.wrangler",
			"!**/*.jsonl",
			"!**/*.md",
			"!images/browser/agent"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noNonNullAssertion": "off",
				"useImportType": "error",
				"useExportType": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"css": { "parser": { "tailwindDirectives": true } },
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"overrides": [
		{
			"includes": ["packages/*/src/**"],
			"linter": {
				"rules": {
					"correctness": { "noNodejsModules": "error" }
				}
			}
		},
		{
			"includes": ["packages/tunnel/src/**", "packages/compute/src/serve.ts", "packages/cli/src/**"],
			"linter": {
				"rules": {
					"correctness": { "noNodejsModules": "off" }
				}
			}
		},
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" }
				}
			}
		}
	]
}
