{
	"name": "@kantel/example-sal-worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "A Sal worker's skills and memory on Kantel. Sal's OKF memory bundle and Git skill sources as Kantel snapshots and revisions, Sal's recall rendering, and a parity harness against a local Sal",
	"license": "Apache-2.0",
	"scripts": {
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run",
		"kantel": "node scripts/kantel-sal.ts",
		"parity": "node scripts/parity.ts",
		"import": "node scripts/import-to-kantel.ts"
	},
	"dependencies": {
		"@kantel/api": "workspace:*",
		"@kantel/contracts": "workspace:*",
		"@kantel/memory": "workspace:*",
		"@kantel/skills": "workspace:*",
		"@kantel/sql": "workspace:*",
		"@kantel/workspace": "workspace:*",
		"ignore": "7.0.14",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	}
}
