{
	// The console's files (apps/console/dist), as their own Worker. It has no route and no URL of its own: the `harbour`
	// Worker (wrangler.jsonc) is the only way in, through its ASSETS service binding, behind the same Cloudflare Access
	// and the same routing (src/route.ts `consoleAsset`). Kept apart so that deploying a console change replaces this
	// Worker only. A new version of `harbour` resets every one of its Durable Objects, and with them every host link,
	// kantel ssh tunnel, desktop, browser and streamed command; a new version of this one resets nothing.
	//
	// The deploy workflow writes wrangler.console.deploy.json from this, adding only the account
	// (scripts/deploy-config.ts `consoleDeployConfig`).
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kantel-console",
	"main": "src/console-worker.ts",
	"compatibility_date": "2026-10-01",
	// Never reachable on workers.dev or a preview URL: those would bypass Access, which guards only KANTEL_HOSTNAME.
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"assets": {
		"directory": "../console/dist",
		"binding": "ASSETS",
		// A miss is a 404 for `harbour` to answer (src/route.ts `consoleAsset`): a missing /assets/ file stays a 404, not
		// the console's page with a 200, so a tab opened before a deploy can't load the page as a script; any other path
		// gets the page.
		"not_found_handling": "none",
		// Every request reaches the Worker, which answers it from the binding, whichever way the request came.
		"run_worker_first": true
	}
}
