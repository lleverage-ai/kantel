{
	"name": "@harbour/cloudflare",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "M1-CF1: Harbour on Cloudflare. The gateway Worker (console, session, workspace and audit APIs behind Access) and its Durable Objects",
	"license": "Apache-2.0",
	"scripts": {
		"build:console": "pnpm --filter @harbour/console build",
		"build:isolate": "node scripts/build-isolate.ts",
		"dev": "pnpm build:console && pnpm build:isolate && wrangler dev --env dev",
		"deploy:dry-run": "pnpm build:console && pnpm build:isolate && wrangler deploy --dry-run --outdir dist --env=\"\"",
		"deploy:config": "node scripts/deploy-config.ts",
		"deploy:check-access": "node scripts/check-access.ts",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-codemode": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@harbour/audit": "workspace:*",
		"@harbour/browser": "workspace:*",
		"@harbour/cloudflare-workspace": "workspace:*",
		"@harbour/contracts": "workspace:*",
		"@harbour/identity": "workspace:*",
		"@harbour/memory": "workspace:*",
		"@harbour/model-gateway": "workspace:*",
		"@harbour/runtime": "workspace:*",
		"@harbour/runtime-cloudflare": "workspace:*",
		"@harbour/sandbox": "workspace:*",
		"@harbour/schedules": "workspace:*",
		"@harbour/skills": "workspace:*",
		"@harbour/sql": "workspace:*",
		"@harbour/usage": "workspace:*",
		"@harbour/vault": "workspace:*",
		"@harbour/vault-cloudflare": "workspace:*",
		"@harbour/workspace": "workspace:*",
		"@jitl/quickjs-wasmfile-release-sync": "0.32.0",
		"hast-util-to-html": "9.0.5",
		"quickjs-wasi": "3.6.2",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"unified": "11.0.5",
		"unpdf": "1.9.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261027.1",
		"@harbour/protocol": "workspace:*",
		"@harbour/testing": "workspace:*",
		"@types/hast": "3.0.4",
		"@types/node": "24.19.2",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"vitest": "4.1.12",
		"wrangler": "4.153.0"
	}
}
