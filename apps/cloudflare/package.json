{
	"name": "@kantel/cloudflare",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Kantel on Cloudflare. The gateway Worker (the compute, identity and audit APIs behind Access) with its Durable Objects, and the console's own Worker",
	"license": "Apache-2.0",
	"scripts": {
		"build:console": "pnpm --filter @kantel/console build",
		"dev": "pnpm build:console && wrangler dev --env dev",
		"deploy:dry-run": "pnpm build:console && wrangler deploy --dry-run --outdir dist/harbour --env=\"\" && wrangler deploy --dry-run --config wrangler.console.jsonc --outdir dist/console",
		"deploy:config": "node scripts/deploy-config.ts",
		"deploy:check-access": "node scripts/check-access.ts",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@kantel/audit": "workspace:*",
		"@kantel/compute": "workspace:*",
		"@kantel/contracts": "workspace:*",
		"@kantel/hosts": "workspace:*",
		"@kantel/identity": "workspace:*",
		"@kantel/sql": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261027.1",
		"@kantel/testing": "workspace:*",
		"@types/node": "24.19.2",
		"typescript": "7.0.2",
		"vitest": "4.1.12",
		"wrangler": "4.153.0"
	}
}
