{
	"name": "@kantel/cloudflare",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Kantel on Cloudflare. The gateway Worker (console, session, workspace and audit APIs behind Access) and its Durable Objects",
	"license": "Apache-2.0",
	"scripts": {
		"build:console": "pnpm --filter @kantel/console build",
		"build:isolate": "node scripts/build-isolate.ts",
		"dev": "pnpm build:console && pnpm build:isolate && wrangler dev --env dev",
		"dev:codemode": "wrangler dev --config wrangler.codemode.jsonc --port 8788 --inspector-port 9230",
		"deploy:dry-run": "pnpm build:console && pnpm build:isolate && wrangler deploy --dry-run --outdir dist --env=\"\" && wrangler deploy --dry-run --config wrangler.codemode.jsonc --outdir dist/codemode",
		"deploy:config": "node scripts/deploy-config.ts",
		"deploy:check-access": "node scripts/check-access.ts",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-codemode": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@kantel/api": "workspace:*",
		"@kantel/audit": "workspace:*",
		"@kantel/browser": "workspace:*",
		"@kantel/cloudflare-workspace": "workspace:*",
		"@kantel/contracts": "workspace:*",
		"@kantel/identity": "workspace:*",
		"@kantel/memory": "workspace:*",
		"@kantel/model-gateway": "workspace:*",
		"@kantel/programs": "workspace:*",
		"@kantel/runtime": "workspace:*",
		"@kantel/runtime-cloudflare": "workspace:*",
		"@kantel/sandbox": "workspace:*",
		"@kantel/schedules": "workspace:*",
		"@kantel/rules": "workspace:*",
		"@kantel/connections": "workspace:*",
		"@kantel/sharing": "workspace:*",
		"@kantel/skills": "workspace:*",
		"@kantel/tools": "workspace:*",
		"@kantel/sql": "workspace:*",
		"@kantel/usage": "workspace:*",
		"@kantel/vault": "workspace:*",
		"@kantel/vault-cloudflare": "workspace:*",
		"@kantel/workspace": "workspace:*",
		"@jitl/quickjs-wasmfile-release-sync": "0.32.0",
		"hast-util-to-html": "9.0.5",
		"quickjs-wasi": "3.6.2",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"typebox": "1.3.27",
		"unified": "11.0.5",
		"unpdf": "1.9.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261027.1",
		"@kantel/protocol": "workspace:*",
		"@kantel/testing": "workspace:*",
		"@types/hast": "3.0.4",
		"@types/node": "24.19.2",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"vitest": "4.1.12",
		"wrangler": "4.153.0"
	}
}
