{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024", "DOM"],
		"types": ["node"]
	},
	// The tests run the portable modules (config, stack, gateway) in Node. Nothing they import may reach
	// cloudflare:workers.
	"include": ["test/**/*.ts", "vitest.config.ts"]
}
