{
	// Harbour M1 on Cloudflare (issue #17). One hostname serves the console (static assets) and the gateway (/v1/*),
	// behind Cloudflare Access. The deploy workflow (scripts/deploy-config.ts) adds the account, the zone route, the
	// Access vars and the models VPC service at deploy time; nothing here names an account, a zone or a hostname.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "harbour",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// Never reachable on workers.dev or a preview URL: those would bypass Access, which guards only HARBOUR_HOSTNAME.
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	// The isolates' code (scripts/build-isolate.ts), imported as text for the Worker Loader, and QuickJS's WebAssembly as
	// bytes for code mode's isolate.
	"rules": [
		{ "type": "Text", "globs": ["**/*.bundle.txt"], "fallthrough": true },
		{ "type": "Data", "globs": ["**/*.wasm.bin"], "fallthrough": true }
	],
	"assets": {
		"directory": "../console/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// The API and health check always reach the Worker; every other path is the console.
		"run_worker_first": ["/v1/*", "/healthz"]
	},
	// The Worker Loader: the dynamic-worker isolate backend loads one Dynamic Worker per session through it
	// (src/dynamic-worker.ts). Sessions use it only when HARBOUR_ISOLATE_BACKEND says so. Code mode loads one per session
	// that runs a script (src/codemode.ts), unless HARBOUR_CODEMODE is `off`.
	"worker_loaders": [{ "binding": "LOADER" }],
	"durable_objects": {
		"bindings": [
			{ "name": "STACK", "class_name": "HarbourStack" },
			// The VaultDO (src/vault-object.ts): every vault record in its own SQLite. Its key and the components' shared
			// keys are Worker secrets (src/vault.ts), never vars here.
			{ "name": "VAULTS", "class_name": "HarbourVault" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["HarbourStack"] },
		{ "tag": "v2", "new_sqlite_classes": ["HarbourVault"] }
	],
	// Named but not given IDs: deploys find them by name, and wrangler's automatic provisioning would create one that's
	// missing. A dry run creates nothing. D1 holds the directory and audit; R2 the workspaces. Both were made with the
	// weur location hint, next to the objects (docs/measurements/m1-cf1/README.md); the first ones, `harbour` and
	// `harbour-workspaces`, are deleted. The deploy can point them at others (HARBOUR_D1_DATABASE_NAME with
	// HARBOUR_D1_DATABASE_ID, HARBOUR_R2_BUCKET; see scripts/deploy-config.ts).
	"d1_databases": [{ "binding": "DB", "database_name": "harbour-weur" }],
	"r2_buckets": [{ "binding": "WORKSPACES", "bucket_name": "harbour-workspaces-weur" }],
	"vars": {
		// The Access team domain (such as harbour.cloudflareaccess.com) and the Access application's AUD tag. Empty means
		// people cannot sign in; API keys still work. The deploy workflow fills both from repository variables.
		"HARBOUR_ACCESS_TEAM_DOMAIN": "",
		"HARBOUR_ACCESS_AUD": "",
		// The first admin, invited by email: Access's verified email links them on first sign-in. Empty: nobody is invited.
		"HARBOUR_ADMIN_EMAIL": "",
		// The CLIProxyAPI model the `default` route serves (src/models.ts). Its key is the HARBOUR_CPA_API_KEY secret.
		"HARBOUR_DEFAULT_MODEL": "claude-sonnet-5-5",
		// Which isolate backend sessions run on (src/sandboxes.ts): in-process, #94's just-bash in the stack object, or
		// dynamic-worker, the same shell in a Dynamic Worker per session. The measurement can run on either.
		"HARBOUR_ISOLATE_BACKEND": "in-process",
		// `off` takes the `codemode` tool away (src/codemode.ts). Anything else offers it to sessions with tools.
		"HARBOUR_CODEMODE": "on",
		// `off` stops serving a session's events over a compressed WebSocket (src/stack-object.ts); the console then reads
		// them as server-sent events. Anything else serves both, and the console prefers the socket.
		"HARBOUR_SESSION_WEBSOCKET": "on",
		// The location hint the stack and vault objects are created with (src/route.ts): weur, the region Amsterdam is in.
		// Only a new object takes it; one that exists stays where it was created. The deploy can override it.
		"HARBOUR_LOCATION_HINT": "weur"
	},
	"env": {
		// `wrangler dev --env dev` (pnpm dev): src/dev.ts adds a mock Access issuer and a dev API key for local testing.
		// It is a separate entry point, so none of it is in the deployed bundle.
		"dev": {
			"name": "harbour-dev",
			"main": "src/dev.ts",
			"workers_dev": false,
			"preview_urls": false,
			"assets": {
				"directory": "../console/dist",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application",
				"run_worker_first": ["/v1/*", "/healthz", "/__dev/*"]
			},
			"worker_loaders": [{ "binding": "LOADER" }],
			"durable_objects": {
				"bindings": [
					{ "name": "STACK", "class_name": "HarbourStack" },
					{ "name": "VAULTS", "class_name": "HarbourVault" }
				]
			},
			// Local only: wrangler dev simulates both.
			"d1_databases": [{ "binding": "DB", "database_name": "harbour-dev" }],
			"r2_buckets": [{ "binding": "WORKSPACES", "bucket_name": "harbour-dev-workspaces" }],
			"vars": {
				"HARBOUR_ACCESS_TEAM_DOMAIN": "harbour-dev.cloudflareaccess.com",
				"HARBOUR_ACCESS_AUD": "harbour-dev-aud",
				"HARBOUR_ADMIN_EMAIL": "dev@harbour.test",
				// The name the console shows for the dev admin (src/config.ts); deployed, the admin's email stands in for it.
				"HARBOUR_ADMIN_NAME": "Dev admin",
				"HARBOUR_LOCATION_HINT": "weur",
				// Local only, and public on purpose: the dev vault's key (base64 of "harbour-local-dev-vault-key-0001") and the
				// model gateway's shared key for it. They seal nothing but `wrangler dev`'s own state. The deployed Worker's are
				// secrets; scripts/deploy-config.ts refuses them as vars.
				"HARBOUR_VAULT_KEY": "aGFyYm91ci1sb2NhbC1kZXYtdmF1bHQta2V5LTAwMDE=",
				"HARBOUR_VAULT_MODEL_GATEWAY_TOKEN": "harbour-dev-model-gateway-token"
			}
		}
	}
}
