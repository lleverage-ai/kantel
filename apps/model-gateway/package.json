{
	"name": "@kantel/model-gateway",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "The model gateway service: @kantel/models behind a Node http server or a Worker, reading connector keys from the vault's egress decision API",
	"license": "Apache-2.0",
	"exports": {
		".": "./src/app.ts",
		"./node": "./src/node.ts",
		"./worker": "./src/worker.ts"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@kantel/audit": "workspace:*",
		"@kantel/contracts": "workspace:*",
		"@kantel/models": "workspace:*",
		"@kantel/vault": "workspace:*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.4.0",
		"@kantel/testing": "workspace:*",
		"@types/node": "24.19.2",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	}
}
