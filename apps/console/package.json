{
	"name": "@kantel/console",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "Kantel's console: the compute console on the gateway's compute API, behind Kantel's sign-in.",
	"license": "Apache-2.0",
	"scripts": {
		"dev": "vite",
		"dev:recorded": "VITE_KANTEL_SOURCE=recorded vite",
		"build": "tsc --noEmit -p tsconfig.json && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@kantel/api": "workspace:*",
		"@kantel/contracts": "workspace:*",
		"@kantel/identity": "workspace:*",
		"@kantel/ui": "workspace:*",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@kantel/compute": "workspace:*",
		"@kantel/hosts": "workspace:*",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"playwright-core": "1.64.1",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
