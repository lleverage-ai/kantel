{
	"name": "@kantel/console",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "Kantel's session console: projects, each project's sessions by attention, and the live session view.",
	"license": "Apache-2.0",
	"scripts": {
		"fixtures": "node scripts/generate-fixture.ts && node scripts/project-fixtures.ts",
		"fixtures:check": "node scripts/project-fixtures.ts --check",
		"predev": "node scripts/generate-fixture.ts && node scripts/project-fixtures.ts",
		"dev": "vite",
		"predev:recorded": "node scripts/generate-fixture.ts && node scripts/project-fixtures.ts",
		"dev:recorded": "VITE_KANTEL_SOURCE=recorded vite",
		"prebuild": "node scripts/generate-fixture.ts && node scripts/project-fixtures.ts",
		"build": "tsc --noEmit -p tsconfig.json && vite build",
		"build:profiling": "node scripts/generate-fixture.ts && node scripts/project-fixtures.ts && vite build --mode profiling",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"pretest": "node scripts/generate-fixture.ts && node scripts/project-fixtures.ts",
		"test": "vitest run",
		"evidence": "node scripts/evidence.ts",
		"oversight:check": "node scripts/oversight-check.ts"
	},
	"dependencies": {
		"@kantel/api": "workspace:*",
		"@kantel/audit": "workspace:*",
		"@kantel/contracts": "workspace:*",
		"@kantel/identity": "workspace:*",
		"@kantel/protocol": "workspace:*",
		"@kantel/ui": "workspace:*",
		"@kantel/vault": "workspace:*",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@kantel/memory": "workspace:*",
		"@kantel/runtime": "workspace:*",
		"@kantel/sandbox": "workspace:*",
		"@kantel/skills": "workspace:*",
		"@kantel/workspace": "workspace:*",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"axe-core": "4.11.0",
		"playwright-core": "1.64.1",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
