{
	"compilerOptions": {
		"target": "ES2023",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noImplicitOverride": true,
		"types": ["bun"]
	},
	"include": ["src", "test", "../../spike/contracts", "../../spike/scenario", "../../spike/conformance"],
	"exclude": ["src/gateway", "test/gateway"]
}
