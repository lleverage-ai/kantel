# The build context is the repo root (see Dockerfile). Leave out what the
# image rebuilds or never needs.
.git
**/node_modules
**/dist
**/.wrangler
**/coverage
**/.harbour
**/*.tsbuildinfo
.env
.env.*
# An install's settings (deploy/compose/.env: the secrets key, a database URL with its password) are the stack's
# runtime environment, never the image's.
**/.env
**/.env.*
**/.dev.vars
