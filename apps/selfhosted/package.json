{
	"name": "@harbour/selfhosted",
	"private": true,
	"type": "module",
	"description": "Harbour self-hosted gateway and session hosts",
	"scripts": {
		"host": "bun src/main.ts host",
		"gateway": "bun src/gateway/main.ts",
		"test": "vitest run",
		"test:stack": "bun test",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.gateway.json"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@harbour/audit": "workspace:*",
		"@harbour/browser": "workspace:*",
		"@harbour/contracts": "workspace:*",
		"@harbour/identity": "workspace:*",
		"@harbour/memory": "workspace:*",
		"@harbour/model-gateway": "workspace:*",
		"@harbour/runtime": "workspace:*",
		"@harbour/sandbox": "workspace:*",
		"@harbour/selfhosted-workspace": "workspace:*",
		"@harbour/sharing": "workspace:*",
		"@harbour/skills": "workspace:*",
		"@harbour/sql": "workspace:*",
		"@harbour/usage": "workspace:*",
		"@harbour/vault": "workspace:*",
		"@harbour/vault-selfhosted": "workspace:*",
		"@harbour/workspace": "workspace:*",
		"aws4fetch": "1.0.20",
		"pg": "8.16.3",
		"pg-connection-string": "2.14.1",
		"ws": "8.22.0"
	},
	"devDependencies": {
		"@harbour/testing": "workspace:*",
		"@types/bun": "1.3.1",
		"@types/node": "24.19.2",
		"@types/pg": "8.15.5",
		"@types/ws": "8.18.2",
		"typescript": "5.9.3",
		"vitest": "4.1.12"
	}
