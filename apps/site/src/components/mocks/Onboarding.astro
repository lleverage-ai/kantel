---
// First-run setup, step 1 of 3 (@kantel/ui's onboarding page): the three steps, then Connect a model with a
// subscription signed in, another to sign in to, and API keys to add.
import Icon from "./Icon.astro";
import Mock from "./Mock.astro";

const steps = [
	{ n: 1, title: "Connect a model", state: "To do", current: true },
	{ n: 2, title: "Add connectors", state: "To do" },
	{ n: 3, title: "Start your first session", state: "To do" },
];
const keys = [
	{ name: "Anthropic", text: "Claude models on Anthropic's API, billed to your Anthropic organisation." },
	{ name: "OpenAI", text: "GPT models on OpenAI's API, billed to your OpenAI organisation." },
	{ name: "OpenRouter", text: "Models from many providers with one OpenRouter key." },
];
---

<Mock
	label="Kantel's first-run setup, step 1 of 3, Connect a model: a Claude subscription signed in, ChatGPT to sign in to, and API keys to add for Anthropic, OpenAI and OpenRouter."
>
	<div class="flex flex-col gap-5">
		<div class="flex items-start justify-between gap-4">
			<div>
				<h3 class="m-title">Set up Kantel</h3>
				<p class="mt-1 m-sm m-muted">Three steps, each one optional. Your progress is saved.</p>
			</div>
			<span class="m-sm whitespace-nowrap m-muted">Skip setup</span>
		</div>

		<ol class="steps">
			{
				steps.map((step) => (
					<li class:list={["step", step.current && "current"]}>
						<span class="num">{step.n}</span>
						<span class="label min-w-0">
							<span class="truncate m-sm">{step.title}</span>
							<span class="m-hide-narrow m-xs m-muted">{step.state}</span>
						</span>
					</li>
				))
			}
		</ol>

		<div class="m-card p-4">
			<p class="m-xs m-faint">Step 1 of 3</p>
			<h4 class="mt-1 m-strong">Connect a model</h4>
			<p class="mt-1 m-sm m-muted">
				Sign in with a Claude or ChatGPT subscription, or add a provider's API key. Keys go into the vault.
			</p>

			<p class="mt-5 mb-2 m-sm m-strong">Subscriptions</p>
			<div class="m-raised m-rows">
				<div class="row">
					<Icon name="spark" class="m-faint" />
					<div class="min-w-0 flex-1">
						<p>Claude</p>
						<p class="m-hide-narrow m-sm m-faint">Your Claude Pro or Max subscription.</p>
					</div>
					<span class="m-badge m-done">
						Signed in<span class="m-hide-narrow">&nbsp;as you@example.com</span>
					</span>
				</div>
				<div class="row">
					<Icon name="spark" class="m-faint" />
					<div class="min-w-0 flex-1">
						<p>ChatGPT</p>
						<p class="m-hide-narrow m-sm m-faint">Your ChatGPT Plus or Pro subscription.</p>
					</div>
					<span class="m-button">Sign in</span>
				</div>
			</div>

			<p class="mt-5 mb-2 m-sm m-strong">API keys</p>
			<div class="m-raised m-rows">
				{
					keys.map((key) => (
						<div class="row">
							<Icon name="key" class="m-faint" />
							<div class="min-w-0 flex-1">
								<p>{key.name}</p>
								<p class="m-hide-narrow m-sm m-faint">{key.text}</p>
							</div>
							<span class="m-button">
								<Icon name="key" class="m-icon-sm" />
								Add key
							</span>
						</div>
					))
				}
			</div>
		</div>
	</div>
</Mock>

<style>
	/* Narrow, the step you're on keeps its words and the others shrink to their numbers. */
	.steps {
		display: flex;
		gap: var(--kt-step-2);
	}

	.step {
		flex: none;
	}

	.step.current {
		flex: 1;
	}

	.label {
		display: flex;
		flex-direction: column;
	}

	.step:not(.current) .label {
		display: none;
	}

	@container (min-width: 30rem) {
		.step {
			flex: 1;
		}

		.step:not(.current) .label {
			display: flex;
		}
	}

	.step {
		display: flex;
		align-items: center;
		gap: var(--kt-step-2_5);
		min-width: 0;
		padding: var(--kt-step-2_5) var(--kt-step-3);
		border-radius: var(--kt-radius-control);
		border: var(--kt-hairline) solid var(--kt-border-strong);
		background: var(--kt-panel);
	}

	.step.current {
		border-color: var(--kt-accent);
		background: var(--kt-accent-soft);
	}

	.num {
		display: grid;
		place-items: center;
		flex: none;
		width: var(--kt-control-xs);
		height: var(--kt-control-xs);
		border-radius: var(--kt-radius-full);
		background: var(--kt-sunken);
		font-size: var(--kt-text-xs);
		font-weight: var(--kt-weight-strong);
	}

	.current .num {
		background: var(--kt-accent);
		color: var(--kt-accent-fg);
	}

	.row {
		display: flex;
		align-items: center;
		gap: var(--kt-step-3);
		padding: var(--kt-step-3);
	}
</style>
