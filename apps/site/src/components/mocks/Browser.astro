---
// An agent's browser, live (@kantel/ui's session/browser-window.tsx): its tabs, a read-only address bar, the page as the
// agent sees it, and what it's doing now. The page is a made-up fare search, drawn in the page's own light colours.
import Icon from "./Icon.astro";
import Mock from "./Mock.astro";

const tabs = [
	{ letter: "K", title: "London to Amsterdam fli…", current: true },
	{ letter: "S", title: "skyscanner.net" },
];
const fares = [
	{ times: "13:40 – 15:55", carrier: "Direct, 1h 15m", price: "£96" },
	{ times: "07:15 – 09:30", carrier: "Direct, 1h 15m", price: "£112" },
	{ times: "10:05 – 12:20", carrier: "Direct, 1h 15m", price: "£138" },
];
---

<Mock
	class="p-0"
	label="An agent's browser in Kantel, live: tabs for kayak.co.uk and skyscanner.net, the address bar, a fare search for London to Amsterdam sorted cheapest first, and the step the agent is taking, reading the cheapest fare. You can watch, not steer."
>
	<div class="flex items-center gap-1 px-2 pt-2 m-sm">
		{
			tabs.map((tab) => (
				<span class:list={["tab", tab.current && "current"]}>
					<span class="favicon">{tab.letter}</span>
					<span class="truncate">{tab.title}</span>
				</span>
			))
		}
		<span class="ml-auto flex items-center gap-3 pr-2 m-xs m-muted">
			<span class="flex items-center gap-1.5 live"><span class="m-dot"></span>Live</span>
			<span class="m-hide-narrow">Watch only</span>
		</span>
	</div>
	<div class="px-2 pb-2">
		<div class="address m-sm">
			<Icon name="lock" class="m-icon-sm m-faint" />
			<span class="truncate">www.kayak.co.uk<span class="m-faint">/flights/LON-AMS/2026-11-12</span></span>
		</div>
	</div>
	<div class="page">
		<div class="flex items-baseline justify-between gap-4">
			<p class="page-title">London to Amsterdam</p>
			<p class="page-meta m-hide-narrow">Thu 12 Nov, 1 adult</p>
		</div>
		<div class="mt-3 flex gap-2">
			<span class="chip on">Cheapest</span><span class="chip">Fastest</span><span class="chip">Best</span>
		</div>
		<div class="mt-3 flex flex-col gap-2">
			{
				fares.map((fare) => (
					<div class="fare">
						<div class="min-w-0">
							<p class="fare-times">{fare.times}</p>
							<p class="page-meta truncate">{fare.carrier}</p>
						</div>
						<p class="fare-price">{fare.price}</p>
					</div>
				))
			}
		</div>
		<span class="cursor" aria-hidden="true"></span>
	</div>
	<div class="flex items-center gap-2 px-4 py-3 m-sm">
		<span class="m-spinner"></span>
		<span class="m-muted">Reading the cheapest fare</span>
		<span class="m-hide-narrow ml-auto m-xs m-faint">kayak.co.uk, skyscanner.net allowed</span>
	</div>
</Mock>

<style>
	.tab {
		display: flex;
		align-items: center;
		gap: var(--kt-step-2);
		min-width: 0;
		max-width: 14rem;
		padding: var(--kt-step-1_5) var(--kt-step-3);
		border-radius: var(--kt-radius-control) var(--kt-radius-control) 0 0;
		color: var(--kt-text-muted);
	}

	.tab.current {
		background: var(--kt-raised);
		color: var(--kt-text);
	}

	.favicon {
		display: grid;
		place-items: center;
		flex: none;
		width: var(--kt-step-4);
		height: var(--kt-step-4);
		border-radius: var(--kt-radius-xs);
		background: var(--kt-user-message);
		font-size: var(--kt-text-2xs);
		font-weight: var(--kt-weight-strong);
	}

	.live {
		color: var(--kt-status-done);
	}

	.address {
		display: flex;
		align-items: center;
		gap: var(--kt-step-2);
		padding: var(--kt-step-1_5) var(--kt-step-3);
		background: var(--kt-sunken);
		border-radius: var(--kt-radius-full);
	}

	/* The web page: a site's own colours, not the console's. */
	.page {
		position: relative;
		background: var(--color-card);
		color: var(--color-midnight);
		padding: var(--kt-step-5) var(--kt-step-6);
		font-size: var(--kt-text-sm);
	}

	.page-title {
		font-size: var(--kt-text-lg);
		font-weight: var(--kt-weight-strong);
	}

	.page-meta {
		color: var(--color-label);
		font-size: var(--kt-text-xs);
	}

	.chip {
		padding: var(--kt-step-1) var(--kt-step-3);
		border-radius: var(--kt-radius-full);
		border: var(--kt-hairline) solid var(--color-line);
		font-size: var(--kt-text-xs);
	}

	.chip.on {
		background: var(--color-midnight);
		border-color: var(--color-midnight);
		color: var(--color-paper);
	}

	.fare {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--kt-step-4);
		padding: var(--kt-step-3) var(--kt-step-4);
		border: var(--kt-hairline) solid var(--color-card-line);
		border-radius: var(--kt-radius-control);
	}

	.fare-times {
		font-weight: var(--kt-weight-medium);
	}

	.fare-price {
		font-size: var(--kt-text-lg);
		font-weight: var(--kt-weight-strong);
	}

	/* The agent's pointer, on the sort it just clicked. */
	.cursor {
		position: absolute;
		left: calc(var(--kt-step-6) + var(--kt-step-12));
		top: calc(var(--kt-step-12) + var(--kt-step-5));
		width: var(--kt-step-5);
		height: var(--kt-step-5);
		border-radius: var(--kt-radius-full);
		border: var(--kt-ring) solid var(--kt-status-working);
		background: var(--kt-status-working-soft);
	}
</style>
