---
// Signing in to the hosted console: one GitHub button, and the personal space that's ready on the first sign-in.
import Mock from "./Mock.astro";

interface Props {
	class?: string;
}
const { class: className } = Astro.props;

const GITHUB =
	"M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z";
---

<Mock
	class:list={["flex flex-col justify-center", className]}
	label="Kantel's sign-in: a Continue with GitHub button, and below it the personal space that is ready after signing in, with an option to create an organisation."
>
	<div class="mx-auto flex w-full max-w-xs flex-col gap-4">
		<p class="m-title">Sign in to Kantel</p>
		<span class="m-button m-primary justify-center">
			<svg class="m-icon-sm m-icon" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d={GITHUB}></path></svg>
			Continue with GitHub
		</span>
		<div class="m-card m-rows mt-1 m-sm">
			<div class="flex items-center gap-2 px-3 py-2.5">
				<span class="avatar">A</span>
				<span class="min-w-0 flex-1 truncate">ada</span>
				<span class="m-badge m-done">Personal</span>
			</div>
			<div class="flex items-center gap-2 px-3 py-2.5 m-muted">
				<span class="avatar avatar-org">+</span>
				<span class="min-w-0 flex-1 truncate">Create an organisation</span>
			</div>
		</div>
	</div>
</Mock>

<style>
	.avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--kt-step-5);
		height: var(--kt-step-5);
		flex: none;
		border-radius: var(--kt-radius-full);
		background: var(--kt-accent-soft);
		color: var(--kt-accent-text);
		font-size: var(--kt-text-xs);
		font-weight: var(--kt-weight-strong);
	}

	.avatar-org {
		border-radius: var(--kt-radius-xs);
		background: var(--kt-active);
		color: var(--kt-text-muted);
	}
</style>
