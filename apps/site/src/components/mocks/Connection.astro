---
// A connection and its rule, then the approval the rule asks for. Above: a GitHub connection's "What agents may do"
// grid (@kantel/ui's connections/connection-policy.tsx), reads allowed and writes asking. Below: the card a write
// brings up in the session (session/connection-approval.tsx), with its actions.
import Icon from "./Icon.astro";
import Mock from "./Mock.astro";

// GitHub's mark, from Simple Icons (CC0), as @kantel/ui's connections/fixture-logos.ts has it.
const GITHUB =
	"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";

type Answer = "Allow" | "Ask" | "Block";
const tone: Record<Answer, string> = { Allow: "m-done", Ask: "m-approval", Block: "m-error" };
const groups: { name: string; read: Answer; write: Answer; remove: Answer }[] = [
	{ name: "Issues", read: "Allow", write: "Ask", remove: "Block" },
	{ name: "Pull requests", read: "Allow", write: "Ask", remove: "Block" },
	{ name: "Code and branches", read: "Allow", write: "Ask", remove: "Block" },
];
---

<Mock
	label="A GitHub connection in Kantel and its rule, What agents may do: reads allowed, writes ask and deletes blocked for issues, pull requests and code. Below, the approval a write brings up in the session: the agent wants to open an issue, with Approve once, Allow for this session, Always allow and Deny."
>
	<div class="flex flex-col gap-4">
		<div class="m-card p-4">
			<div class="flex items-center gap-3">
				<svg class="m-logo" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={GITHUB}></path></svg>
				<p class="m-strong">GitHub <span class="ml-1 font-normal m-muted">tvdavies</span></p>
				<span class="ml-auto m-badge m-done">Connected</span>
			</div>
			<p class="mt-4 m-sm m-strong">What agents may do</p>
			<div class="policy mt-2 m-sm">
				<span></span><span class="m-xs m-faint">Read</span><span class="m-xs m-faint">Write</span><span
					class="m-hide-narrow m-xs m-faint">Delete</span
				>
				{
					groups.map((group) => (
						<>
							<span class="truncate">{group.name}</span>
							<span class={`m-badge ${tone[group.read]}`}>{group.read}</span>
							<span class={`m-badge ${tone[group.write]}`}>{group.write}</span>
							<span class={`m-hide-narrow m-badge ${tone[group.remove]}`}>{group.remove}</span>
						</>
					))
				}
			</div>
		</div>

		<div class="approval m-card flex flex-col gap-3 p-4">
			<div class="flex flex-wrap items-center gap-2 m-sm">
				<svg class="m-logo small" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={GITHUB}></path></svg>
				<span class="m-muted">GitHub as <span class="m-fg m-strong">tvdavies</span></span>
				<span class="m-badge m-approval">Waiting for you</span>
				<span class="ml-auto m-mono m-xs m-faint">9m left</span>
			</div>
			<div>
				<p class="m-strong">Open an issue in acme/web</p>
				<p class="mt-1 m-mono m-muted">POST /repos/acme/web/issues</p>
			</div>
			<div class="m-fields">
				<span>Agent's reason</span>
				<span>Three tests failed on every nightly run this week. One issue covers them.</span>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				<span class="m-button m-primary"><Icon name="key" class="m-icon-sm" />Approve once</span>
				<span class="m-button">Allow for this session</span>
				<span class="m-hide-narrow m-button">Always allow…</span>
				<span class="ml-auto m-button m-danger">Deny</span>
			</div>
			<p class="m-xs m-muted">Your passkey confirms it's you. The agent sends it once, as soon as you approve.</p>
		</div>
	</div>
</Mock>

<style>
	.policy {
		display: grid;
		grid-template-columns: minmax(0, 1fr) repeat(3, 4.5rem);
		align-items: center;
		gap: var(--kt-step-2) var(--kt-step-3);
	}

	.m-badge {
		justify-self: start;
	}

	.m-logo.small {
		width: var(--kt-icon-md);
		height: var(--kt-icon-md);
	}

	.approval {
		border-color: var(--kt-status-approval-line);
	}

	@container (max-width: 30rem) {
		.policy {
			grid-template-columns: minmax(0, 1fr) repeat(2, 4rem);
		}
	}
</style>
