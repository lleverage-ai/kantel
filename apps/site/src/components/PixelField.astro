---
// The hero's backdrop: a field of Lleverage's upright pixels, lit by drifting clouds, small bursts of work and now and
// then one orange (src/scripts/pixel-field.js says how). It thins out around the elements whose ids `quiet` names, the
// text laid over it, so the text stays legible on every frame. Decorative, so hidden from assistive tech; it draws one
// still frame under reduced motion.
interface Props {
	class?: string;
	/** The ids of the elements over the field to keep clear, space-separated, such as the hero's text. */
	quiet?: string;
}
const { class: className, quiet } = Astro.props;
---

<canvas class:list={["block w-full", className]} data-pixel-field data-pixel-quiet={quiet} aria-hidden="true"></canvas>

<script>
	import { mountPixelField } from "../scripts/pixel-field.js";

	for (const canvas of document.querySelectorAll<HTMLCanvasElement>("canvas[data-pixel-field]")) {
		mountPixelField(canvas);
	}
</script>
