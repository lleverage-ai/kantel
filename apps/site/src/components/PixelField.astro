---
// The hero's animation: a band of Lleverage's upright pixels, lit by drifting clouds, small bursts of work and now
// and then one orange (src/scripts/pixel-field.js says how). Decorative, so hidden from assistive tech; it draws one
// still frame under reduced motion.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<canvas class:list={["block w-full", className]} data-pixel-field aria-hidden="true"></canvas>

<script>
	import { mountPixelField } from "../scripts/pixel-field.js";

	for (const canvas of document.querySelectorAll<HTMLCanvasElement>("canvas[data-pixel-field]")) {
		mountPixelField(canvas);
	}
</script>
