---
// kantel.dev's home, for the compute plane. Above the fold only the headline, the install command, the shape of the
// host join command and the pixel field behind them; then the three steps to a first sandbox, the two types, the
// lifecycle, the ways in from a harness, hosts and the proxy, the rest in brief, self-hosted or hosted, and the way to
// the docs and the source. Claims follow the usage docs (docs/site); the pictures are mocks of the console in its
// default theme (src/components/mocks), not screenshots. The CLI, SDK and MCP server are experimental, and the page
// says so.
import Feature from "../components/Feature.astro";
import InstallCommand from "../components/InstallCommand.astro";
import Hosts from "../components/mocks/Hosts.astro";
import Sandboxes from "../components/mocks/Sandboxes.astro";
import PixelField from "../components/PixelField.astro";
import Base from "../layouts/Base.astro";
import { GITHUB_URL, HOST_JOIN_COMMAND, INSTALL_COMMAND } from "../site.mjs";

const repo = GITHUB_URL.replace("https://github.com/", "");

// A command in words and placeholders, so a placeholder can be set apart from what you type as it is, and each word
// keeps together: a narrow screen wraps between words, never inside `--token` at its dashes.
const commandParts = (command: string): string[] => command.split(/(<[^>]+>| )/).filter((part) => part !== "");

const steps = [
	{
		title: "Install the control plane",
		text: "On any machine with Docker. It serves the console and the API, and decides where each sandbox runs.",
		command: INSTALL_COMMAND,
	},
	{
		title: "Add a host",
		text: "Run one command on each Linux machine, with a token from the console. The host connects out, so it needs no open ports.",
		command: HOST_JOIN_COMMAND,
	},
	{
		title: "Make a sandbox",
		text: "From the console, or from your agent. A microVM is up in about a second.",
		command: "npx kantel sandbox create --type microvm",
	},
];

// The two types, row by row, in the same order in both columns.
const types = [
	{
		name: "Isolate",
		type: "isolate",
		rows: [
			["Starts in", "Milliseconds"],
			["Runs on", "A V8 isolate on workerd, Cloudflare's open-source Workers runtime"],
			["Inside", "A shell and JavaScript"],
			["Costs", "Almost nothing to run, so you can start one for every task"],
			["Use it for", "Quick scripts, file work and tool calls that don't need a Linux kernel"],
		],
	},
	{
		name: "MicroVM",
		type: "microvm",
		rows: [
			["Starts in", "About a second, from a snapshot"],
			["Runs on", "A Firecracker virtual machine with its own Linux kernel"],
			["Inside", "Root, packages, Docker, systemd, and /dev/kvm for virtual machines of its own"],
			["Costs", "The vCPUs, memory and disk you size it with, while it runs"],
			["Use it for", "Builds, test suites, services, desktops and browsers: anything a Linux machine does"],
		],
	},
];

// The harness samples, one tab each, as packages/cli's README and the docs' TypeScript SDK page show them.
const samples = [
	{
		id: "cli",
		tab: "CLI",
		file: "Terminal",
		lines: [
			{ comment: "# A microVM, up in about a second" },
			{ code: "npx kantel sandbox create --type microvm" },
			{ comment: "# Run the tests in it" },
			{ code: "npx kantel exec sbx_7f3k2m9qa1 -- npm test" },
			{ comment: "# Copy it, to try something else from the same state" },
			{ code: "npx kantel sandbox fork sbx_7f3k2m9qa1" },
		],
	},
	{
		id: "sdk",
		tab: "TypeScript",
		file: "agent.ts",
		lines: [
			{ code: 'import { createKantelClient } from "./kantel-sdk.ts";' },
			{ code: "" },
			{ code: "const kantel = createKantelClient({" },
			{ code: '  baseUrl: "https://kantel.example.com/v1",' },
			{ code: "  token: process.env.KANTEL_API_KEY," },
			{ code: "});" },
			{ code: "" },
			{ code: 'const sandbox = await kantel.createSandbox({ type: "microvm", wait: true });' },
			{ code: 'await kantel.runCommand(sandbox.id, { command: "npm test" });' },
		],
	},
	{
		id: "http",
		tab: "HTTP",
		file: "Terminal",
		lines: [
			{ code: 'curl -X POST "$KANTEL_URL/v1/sandboxes" \\' },
			{ code: '  -H "authorization: Bearer $KANTEL_API_KEY" \\' },
			{ code: '  -H "content-type: application/json" \\' },
			{ code: '  -d \'{ "type": "microvm" }\'' },
		],
	},
	{
		id: "mcp",
		tab: "MCP",
		file: ".mcp.json, for Claude Code",
		lines: [
			{ code: "{" },
			{ code: '  "mcpServers": {' },
			{ code: '    "kantel": {' },
			{ code: '      "command": "npx",' },
			{ code: '      "args": ["-y", "kantel", "mcp"],' },
			{ code: '      "env": {' },
			// Claude Code fills in ${VAR} from the environment itself, so these stay literal.
			{ code: `        "KANTEL_URL": "\${KANTEL_URL}",` },
			{ code: `        "KANTEL_API_KEY": "\${KANTEL_API_KEY}"` },
			{ code: "      }" },
			{ code: "    }" },
			{ code: "  }" },
			{ code: "}" },
		],
	},
];

const interfaces = [
	{ name: "The CLI", text: "npx kantel, for you and for any agent with a shell" },
	{ name: "The TypeScript SDK", text: "one generated file with no dependencies, for your own app or agent loop" },
	{ name: "The HTTP API", text: "every route under /v1, from any language" },
	{ name: "An MCP server", text: "sandboxes as tools in Claude Code or any MCP client" },
	{ name: "An AGENTS.md snippet or skill", text: "tells an agent when to reach for a sandbox, and how" },
];

const allowList = [
	{ host: "api.github.com", outcome: "Allowed, with your GitHub token added" },
	{ host: "registry.npmjs.org", outcome: "Allowed" },
	{ host: "pypi.org", outcome: "Allowed" },
	{ host: "Anything else", outcome: "Refused" },
];

const extras = [
	{
		title: "Scoped API keys",
		text: "Give a CI job a key that can create and run sandboxes and nothing else. Kantel shows a key's secret once and keeps only its hash.",
	},
	{
		title: "Webhooks",
		text: "Hear when a sandbox is ready, stops, fails or is deleted, and when a snapshot is saved. Every delivery is signed.",
	},
	{
		title: "OpenTelemetry",
		text: "Send sandbox metrics and lifecycle events to any OTLP collector, next to the rest of your telemetry.",
	},
	{
		title: "Organisations",
		text: "Everyone has a personal account. Share sandboxes, snapshots and keys through an organisation, and switch between them in the console.",
	},
];

const docSections = [
	{ href: "/docs/", title: "What Kantel is", text: "A compute plane for agents, and where to start" },
	{ href: "/docs/concepts/", title: "Concepts", text: "Hosts, sandboxes, snapshots, organisations, keys" },
	{
		href: "/docs/self-hosting/install/",
		title: "Install Kantel",
		text: "The control plane, signing in, your first API key",
	},
	{ href: "/docs/hosted-or-self-hosted/", title: "Hosted or self-hosted", text: "Your own machines, or ours" },
	{ href: "/docs/api/reference/", title: "API reference", text: "Every route, generated from the OpenAPI document" },
];

const link = "underline underline-offset-4 hover:text-midnight";
const linkOnMidnight = "underline decoration-midnight-2 underline-offset-4 hover:decoration-paper";
---

<Base
	title="Kantel, by Lleverage: sandboxes for your agents, on your own machines"
	description="Kantel is a compute plane for AI agents that you run yourself: isolates that start in milliseconds and Firecracker microVMs that start in about a second, behind one API, for Claude Code, Codex, pi or your own app. Install it with one command, and add Linux hosts with one more."
>
	<!-- Hero: the headline, the install command and the shape of the join command over the pixel field, which fills the
	     first screen. Everything else waits below the fold. The hero's height comes from CSS alone (--hero-height), so
	     nothing moves when the field starts drawing. -->
	<section aria-labelledby="hero" class="relative isolate flex min-h-(--hero-height) items-start sm:items-center">
		<PixelField class="absolute inset-0 -z-10 h-full" quiet="hero-copy" />
		<div class="mx-auto w-full max-w-(--container-page) px-6 pt-12 pb-40 sm:py-24 lg:px-12">
			<div id="hero-copy" class="max-w-(--container-hero)">
				<h1 id="hero" class="font-display text-display-m font-semibold tracking-tight text-balance sm:text-display-l">
					Sandboxes for your agents, on your own machines
				</h1>
				<p class="mt-5 max-w-(--container-measure) text-lead text-midnight-2">
					Isolates start in milliseconds and microVMs in about a second. Your agents drive them over one API, from
					Claude Code, Codex, pi or your own app.
				</p>
				<div class="mt-9">
					<InstallCommand id="install-hero" />
					<p class="mt-3 text-sm text-label">
						Needs Docker. <a class={link} href="/install.sh">Read the script</a> first if you like.
					</p>
				</div>
				<div class="mt-7 max-w-(--container-hero) border-l-2 border-midnight pl-4">
					<p class="text-sm font-semibold">Then add each Linux machine that should run sandboxes:</p>
					<p class="mt-1.5 font-mono text-sm break-words text-midnight-2">
						{
							commandParts(HOST_JOIN_COMMAND).map((part) =>
								part.startsWith("<") ? (
									<span class="text-label italic">{part}</span>
								) : part === " " ? (
									" "
								) : (
									<span class="whitespace-nowrap">{part}</span>
								),
							)
						}
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- From nothing to a sandbox: a real sequence, so numbered. -->
	<section class="border-t border-line bg-card" aria-labelledby="first-sandbox">
		<div class="mx-auto max-w-(--container-page) px-6 py-20 lg:px-12 lg:py-28">
			<div class="max-w-(--container-hero)">
				<h2 id="first-sandbox" class="font-display text-display-m font-semibold text-balance">
					Three commands to your first sandbox
				</h2>
				<p class="mt-5 max-w-(--container-measure) text-lead text-midnight-2">
					The control plane serves the console and the API, and never runs a sandbox itself. Hosts are the Linux
					machines that do, and you can add as many as you have.
				</p>
			</div>

			<ol class="mt-14 grid grid-cols-1 gap-x-10 gap-y-12 lg:grid-cols-3">
				{
					steps.map((step, at) => (
						<li class="flex min-w-0 flex-col border-t border-midnight pt-5">
							<p class="font-mono text-sm font-semibold">{at + 1}</p>
							<h3 class="mt-3 font-display text-display-s font-semibold text-balance">{step.title}</h3>
							<p class="mt-3 text-body text-midnight-2">{step.text}</p>
							<div class="mt-auto pt-6">
								<pre class="rounded-tile bg-midnight px-4 py-3 font-mono text-sm leading-relaxed whitespace-pre-wrap break-words text-paper"><code>{commandParts(step.command).map((part) =>
									part.startsWith("<") ? (
										<span class="text-faint italic">{part}</span>
									) : part === " " ? (
										" "
									) : (
										<span class="whitespace-nowrap">{part}</span>
									),
								)}</code></pre>
							</div>
						</li>
					))
				}
			</ol>
			<p class="mt-12 text-body text-midnight-2">
				<a class={link} href="/docs/self-hosting/install/">Install Kantel</a> has the installer's options, signing in,
				upgrading and removing it.
			</p>
		</div>
	</section>

	<!-- The two types, side by side, row for row. -->
	<section class="border-t border-line" aria-labelledby="types">
		<div class="mx-auto max-w-(--container-page) px-6 py-20 lg:px-12 lg:py-28">
			<div class="max-w-(--container-hero)">
				<h2 id="types" class="font-display text-display-m font-semibold text-balance">
					Two kinds of sandbox under one API
				</h2>
				<p class="mt-5 max-w-(--container-measure) text-lead text-midnight-2">
					Pick the type when you create a sandbox. Both take the same calls, so moving work from one to the other
					doesn't change your code.
				</p>
			</div>

			<div
				class="mt-14 grid grid-cols-1 overflow-hidden rounded-card border border-card-line bg-card md:grid-cols-2"
			>
				{
					types.map((kind, at) => (
						<div
							class:list={[
								"grid min-w-0 gap-y-0 p-6 sm:p-8 md:row-span-6 md:grid-rows-subgrid",
								at > 0 && "border-t border-card-line md:border-t-0 md:border-l",
							]}
						>
							<div class="pb-6">
								<h3 class="font-display text-display-s font-semibold">{kind.name}</h3>
								<p class="mt-2 font-mono text-sm text-label">type: "{kind.type}"</p>
							</div>
							<dl class="grid divide-y divide-card-line border-t border-card-line md:row-span-5 md:grid-rows-subgrid">
								{kind.rows.map(([term, value]) => (
									<div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-3 sm:gap-4">
										<dt class="text-sm text-label sm:pt-0.5">{term}</dt>
										<dd class="text-body sm:col-span-2">{value}</dd>
									</div>
								))}
							</dl>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- What a sandbox keeps between runs: the lifecycle, beside the Sandboxes page; then snapshots and the ways in. -->
	<section class="border-t border-line bg-card" aria-labelledby="lifecycle-heading">
		<div class="mx-auto max-w-(--container-page) px-6 py-20 lg:px-12 lg:py-28">
			<div class="max-w-(--container-hero)">
				<h2 id="lifecycle-heading" class="font-display text-display-m font-semibold text-balance">
					Sandboxes that keep their state
				</h2>
				<p class="mt-5 max-w-(--container-measure) text-lead text-midnight-2">
					A stopped sandbox uses no CPU and keeps its disk. Resume it later, or fork it to start several agents from
					the same place.
				</p>
			</div>

			<div class="mt-20">
				<Feature
					id="lifecycle"
					title="Stop, resume and fork"
					route="npx kantel sandbox fork <id>"
					docs={{ href: "/docs/concepts/#lifecycle", label: "The lifecycle" }}
				>
					<p>
						Stop keeps the disk as a snapshot, and resume starts the sandbox from it. Fork copies the latest snapshot
						into a new sandbox, so you can set one up and start many agents from it.
					</p>
					<p>
						Pause a microVM and it keeps its memory too, so it carries on where it was. Recover brings back a sandbox
						that has gone into an error state, and delete removes it with its snapshots.
					</p>
					<Sandboxes slot="mock" />
				</Feature>
			</div>

			<div class="mt-24 grid grid-cols-1 gap-x-12 gap-y-14 lg:grid-cols-2">
				<div class="border-t border-midnight pt-5">
					<h3 class="font-display text-display-s font-semibold text-balance">A snapshot history for every sandbox</h3>
					<p class="mt-4 max-w-(--container-measure) text-body text-midnight-2">
						Kantel takes snapshots as a sandbox runs and when it stops, so each one has a history you can browse and
						restore files from. Save one under a name and it outlives its sandbox: install your tools once, then start
						every new sandbox from there.
					</p>
					<a
						href="/docs/concepts/#snapshots"
						class="mt-5 inline-block border-b border-line pb-0.5 font-semibold text-midnight transition-colors hover:border-midnight"
						>Snapshots</a
					>
				</div>
				<div class="border-t border-midnight pt-5">
					<h3 class="font-display text-display-s font-semibold text-balance">A desktop, a browser, SSH and ports</h3>
					<p class="mt-4 max-w-(--container-measure) text-body text-midnight-2">
						Stream a microVM's desktop or browser to watch an agent work, or step in. SSH into any sandbox, and give
						each port its own public URL to show someone what it built.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- From any harness: the one midnight plate. -->
	<section class="bg-midnight text-paper" aria-labelledby="harnesses">
		<div class="mx-auto grid max-w-(--container-page) grid-cols-1 gap-12 px-6 py-20 lg:grid-cols-12 lg:px-12 lg:py-28">
			<div class="lg:col-span-5">
				<h2 id="harnesses" class="font-display text-display-m font-semibold text-balance">
					Use it from any harness
				</h2>
				<p class="mt-5 text-lead text-faint">
					Kantel doesn't run your agent. Claude Code, Codex, pi or your own loop stays where it is, and creates and
					drives sandboxes from there.
				</p>
				<ul class="mt-8 divide-y divide-midnight-2 border-y border-midnight-2">
					{
						interfaces.map((entry) => (
							<li class="py-3">
								<span class="font-semibold">{entry.name}</span>
								<span class="block text-sm text-faint">{entry.text}</span>
							</li>
						))
					}
				</ul>
				<p class="mt-6 text-sm text-faint">
					The CLI, the SDK and the MCP server are experimental, so their commands and methods may still change.
				</p>
				<p class="mt-6 text-body">
					<a class={linkOnMidnight} href="/docs/api/reference/">API reference</a>
				</p>
				<p class="mt-2 text-body">
					<a class={linkOnMidnight} href="/docs/coding-agents/">Set up a coding agent</a>
				</p>
			</div>
			<div class="min-w-0 lg:col-span-7" data-tabs>
				<div role="tablist" aria-label="Ways to call Kantel" class="flex flex-wrap gap-x-6 gap-y-2 border-b border-midnight-2">
					{
						samples.map((sample, at) => (
							<button
								type="button"
								role="tab"
								id={`tab-${sample.id}`}
								aria-controls={`panel-${sample.id}`}
								aria-selected={at === 0 ? "true" : "false"}
								tabindex={at === 0 ? 0 : -1}
								class="-mb-px cursor-pointer border-b-2 border-transparent pt-1 pb-3 text-sm font-semibold text-faint transition-colors hover:text-paper aria-selected:border-orange aria-selected:text-paper"
							>
								{sample.tab}
							</button>
						))
					}
				</div>
				{
					samples.map((sample, at) => (
						<div
							role="tabpanel"
							id={`panel-${sample.id}`}
							aria-labelledby={`tab-${sample.id}`}
							tabindex="0"
							hidden={at !== 0}
							class="mt-6 overflow-hidden rounded-card bg-midnight-2"
						>
							<p class="border-b border-midnight px-6 py-3 text-sm text-faint">{sample.file}</p>
							<pre class="overflow-x-auto p-6 font-mono text-sm leading-relaxed text-paper"><code>{sample.lines.map((line, index) => (
								<>{index > 0 && "\n"}{"comment" in line ? <span class="text-faint">{line.comment}</span> : line.code}</>
							))}</code></pre>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Hosts and what leaves them. -->
	<section aria-labelledby="hosts-heading">
		<div class="mx-auto max-w-(--container-page) px-6 py-20 lg:px-12 lg:py-28">
			<div class="max-w-(--container-hero)">
				<h2 id="hosts-heading" class="font-display text-display-m font-semibold text-balance">
					Your machines, one console
				</h2>
				<p class="mt-5 max-w-(--container-measure) text-lead text-midnight-2">
					Mix a server under your desk, a few cloud machines and a spare laptop running Linux. The control plane puts
					each new sandbox on a host with room for it.
				</p>
			</div>

			<div class="mt-20 space-y-28 lg:space-y-36">
				<Feature
					id="hosts"
					title="Hosts dial out, and the console shows them"
					docs={{ href: "/docs/concepts/#the-control-plane-and-hosts", label: "The control plane and hosts" }}
				>
					<p>
						A host connects out to the control plane and keeps that connection open, so it needs no inbound ports and
						can sit behind NAT or a home router. It holds no credential but its own, which you can revoke at any time.
					</p>
					<p>
						The console lists every host with the CPU, memory and disk in use and the sandboxes on it. Drain one to
						stop new sandboxes landing there. Hosts are Linux machines with KVM for now; macOS comes later.
					</p>
					<Hosts slot="mock" />
				</Feature>

				<article id="proxy" class="grid scroll-mt-24 grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-12">
					<div class="lg:col-span-5">
						<h3 class="font-display text-display-s font-semibold text-balance">An egress proxy on every host</h3>
						<div class="mt-4 space-y-4 text-body text-midnight-2">
							<p>
								Each host runs a proxy that decides what its sandboxes may reach: anywhere, only the hosts on an allow
								list, or nowhere.
							</p>
							<p>
								It can add a credential to matching requests on the way out, so the token never sits in a sandbox
								where an agent could read it. Or it can forward the traffic to a gateway you already run.
							</p>
						</div>
						<a
							href="/docs/concepts/#the-proxy"
							class="mt-5 inline-block border-b border-line pb-0.5 font-semibold text-midnight transition-colors hover:border-midnight"
							>The proxy</a
						>
					</div>
					<figure class="min-w-0 lg:col-span-7">
						<ul class="divide-y divide-card-line rounded-card border border-card-line bg-card">
							{
								allowList.map((rule) => (
									<li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-5 py-4">
										<span class:list={[rule.host === "Anything else" ? "font-semibold" : "font-mono text-sm"]}>
											{rule.host}
										</span>
										<span class:list={["text-sm", rule.outcome === "Refused" ? "text-midnight" : "text-label"]}>
											{rule.outcome}
										</span>
									</li>
								))
							}
						</ul>
						<figcaption class="mt-3 text-sm text-label">
							An allow list for an agent that works on code: GitHub, npm and PyPI, and nothing else.
						</figcaption>
					</figure>
				</article>
			</div>
		</div>
	</section>

	<!-- The rest, in brief. Not a sequence, so no numbers. -->
	<section class="border-t border-line bg-card" aria-labelledby="around">
		<div class="mx-auto max-w-(--container-page) px-6 py-20 lg:px-12 lg:py-24">
			<h2 id="around" class="max-w-(--container-hero) font-display text-display-m font-semibold text-balance">
				For teams, and the systems around them
			</h2>
			<ul class="mt-14 grid grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
				{
					extras.map((extra) => (
						<li class="border-t border-midnight pt-5">
							<h3 class="text-lead font-semibold">{extra.title}</h3>
