---
// kantel.dev's home: what Kantel is and why you'd want it in one screen, with the console and the CLI's install, then
// the fastest way to a first sandbox on the hosted service (sign in, add a host with one command, create a sandbox).
// Self-hosting lives in the docs, with one quiet link here. Claims follow the usage docs (docs/site); the pictures are
// mocks of the console in its default theme (src/components/mocks and the hero's story, HeroStory), not screenshots.
import InstallCommand from "../components/InstallCommand.astro";
import HeroStory from "../components/HeroStory.astro";
import AddHost from "../components/mocks/AddHost.astro";
import SignIn from "../components/mocks/SignIn.astro";
import Terminal from "../components/mocks/Terminal.astro";
import PixelField from "../components/PixelField.astro";
import Base from "../layouts/Base.astro";
import { CLI_INSTALL_COMMAND, CLI_NEXT_COMMANDS, CONSOLE_URL } from "../site.mjs";

const link = "underline underline-offset-4 hover:text-midnight";
// A step: a column of its own on a phone, and on a wide screen a subgrid over the list's four rows.
const step =
	"flex min-w-0 flex-col border-t border-midnight pt-5 lg:row-span-4 lg:grid lg:grid-rows-subgrid lg:gap-y-0";
---

<Base
	title="Kantel, by Lleverage: sandboxes for your agents, on your own machines"
	description="Kantel gives Claude Code, Codex or your own app isolates and microVMs to work in, on Linux machines you already have. Sign in at app.kantel.dev, add a host with one command, and create sandboxes from the console or the CLI."
>
	<!-- Hero: what Kantel is and why, and the way in, beside the story of what it does (HeroStory), both over the
	     pixel field, which keeps clear of the copy and runs on behind the story's glass. Side by side on a wide screen, the story under the copy otherwise. Its
	     height is CSS only (--hero-height), so nothing moves when the field starts drawing. -->
	<section aria-labelledby="hero" class="relative isolate flex min-h-(--hero-height) items-start sm:items-center">
		<PixelField class="absolute inset-0 -z-10 h-full" quiet="hero-copy" />
		<div
			class="mx-auto grid w-full max-w-(--container-page) grid-cols-1 items-center gap-x-16 gap-y-20 px-6 pt-12 pb-32 sm:py-20 lg:px-12 xl:grid-cols-2"
		>
			<div id="hero-copy" class="max-w-(--container-hero)">
				<h1 id="hero" class="font-display text-display-m font-semibold tracking-tight text-balance sm:text-display-l">
					Sandboxes for your agents, on <span class="text-orange">your own machines</span>
				</h1>
				<p class="mt-5 max-w-(--container-measure) text-lead text-midnight-2">
					Give Claude Code, Codex or your own app a microVM to work in. Your machines connect out to Kantel, with no
					ports to open.
				</p>
				<div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3">
					<a
						href={CONSOLE_URL}
						class="inline-flex items-center rounded-card bg-primary px-6 py-4 font-semibold text-on-primary transition-colors hover:bg-primary-hover"
					>
						Get started
					</a>
					<p class="text-sm text-label">Sign in with your email. Open source, Apache 2.0.</p>
				</div>

				<h2 id="cli" class="mt-12 text-sm font-semibold text-label">Or start from your terminal</h2>
				<div class="mt-3">
					<InstallCommand id="install-cli" command={CLI_INSTALL_COMMAND} next={CLI_NEXT_COMMANDS} />
				</div>
			</div>
			<HeroStory id="hero-story" class="w-full max-w-(--container-hero)" />
		</div>
	</section>

	<!-- The fastest way to a first sandbox: a real sequence, so numbered. -->
	<section class="border-t border-line bg-card" aria-labelledby="start">
		<div class="mx-auto max-w-(--container-page) px-6 py-20 lg:px-12 lg:py-24">
			<h2 id="start" class="max-w-(--container-hero) font-display text-display-m font-semibold text-balance">
				A sandbox in three steps
			</h2>

			<!-- On a wide screen each step is a subgrid of the list's rows, so the three titles, texts and mocks line up. -->
			<ol class="mt-14 grid grid-cols-1 gap-x-8 gap-y-16 lg:grid-cols-3 lg:gap-y-0">
				<li class={step}>
					<p class="font-mono text-sm font-semibold">1</p>
					<h3 class="mt-3 font-display text-display-s font-semibold text-balance">Sign in</h3>
					<p class="mt-3 text-body text-midnight-2">
						With a code we email you. You get a personal space straight away, and can make an organisation to share
						hosts and sandboxes with a team.
					</p>
					<SignIn class="mt-8" />
				</li>
				<li class={step}>
					<p class="font-mono text-sm font-semibold">2</p>
					<h3 class="mt-3 font-display text-display-s font-semibold text-balance">Add a host</h3>
					<p class="mt-3 text-body text-midnight-2">
						Run one command on a Linux machine of yours with KVM. It connects out to Kantel, so it needs no open ports
						and can sit behind NAT. Your sandboxes run only on your hosts.
					</p>
					<AddHost class="mt-8" />
				</li>
				<li class={step}>
					<p class="font-mono text-sm font-semibold">3</p>
					<h3 class="mt-3 font-display text-display-s font-semibold text-balance">Create a sandbox</h3>
					<p class="mt-3 text-body text-midnight-2">
						In the console, from the CLI, or from your agent through the API or the MCP server. A microVM is up in about
						a second.
					</p>
					<Terminal class="mt-8" />
				</li>
			</ol>

			<p class="mt-16 text-body text-midnight-2">
				<a class={link} href="/docs/quickstart/">The quick start</a> takes you from here to a running sandbox.
			</p>
			<p class="mt-4 text-sm text-label">
				Self-hosting? Run the control plane yourself too:{" "}
				<a class={link} href="/docs/self-hosting/quickstart/">read the docs</a>.
			</p>
		</div>
	</section>
</Base>
