---
// kantel.dev's home: the install command first, then what you get once Kantel is running, then the API, packaged
// agents, and the way to the docs and the source. Every claim here is in the usage docs (docs/site); the shots are the
// real console (src/assets/shots/README.md says where each comes from).
import approval from "../assets/shots/approval.png";
import browser from "../assets/shots/browser.png";
import codemode from "../assets/shots/codemode.png";
import connections from "../assets/shots/connections.png";
import consoleShot from "../assets/shots/console.png";
import onboarding from "../assets/shots/onboarding.png";
import onboardingConnectors from "../assets/shots/onboarding-connectors.png";
import question from "../assets/shots/question.png";
import session from "../assets/shots/session.png";
import vault from "../assets/shots/vault.png";
import Feature from "../components/Feature.astro";
import InstallCommand from "../components/InstallCommand.astro";
import Lever from "../components/Lever.astro";
import Shot from "../components/Shot.astro";
import Base from "../layouts/Base.astro";
import { GITHUB_URL } from "../site.mjs";

const repo = GITHUB_URL.replace("https://github.com/", "");

const docSections = [
	{ href: "/docs/console/getting-started/install/", title: "Getting started", text: "Install, sign in, first steps" },
	{ href: "/docs/console/sessions/", title: "Using the console", text: "Sessions, browsers, connections, schedules" },
	{ href: "/docs/api/concepts/", title: "Building apps", text: "Concepts, keys, streaming, approvals" },
	{ href: "/docs/api/reference/", title: "API reference", text: "Every route, generated from the OpenAPI document" },
	{ href: "/docs/deploy/overview/", title: "Deploying", text: "Your own servers, or Cloudflare" },
];
---

<Base
	title="Kantel, by Lleverage: run AI agents on your own machines"
	description="Kantel runs AI agents for people and for apps: sessions, a sandbox, browsers, connections, approvals and an audit trail, on your own machine or Cloudflare. Install it with one command."
>
	<!-- Hero: who it's from, what it does, and the install command. -->
	<section class="relative">
		<div class="mx-auto grid max-w-(--container-page) grid-cols-1 gap-12 px-6 pt-14 pb-20 lg:grid-cols-12 lg:px-12 lg:pt-24 lg:pb-32">
			<div class="relative z-10 lg:col-span-8">
				<h1 class="font-display text-display-m font-semibold tracking-tight sm:text-display-l">
					Kantel, by Lleverage
				</h1>
				<p class="mt-6 max-w-(--container-hero) font-display text-display-s text-midnight-2 text-balance">
					Run AI agents on your own machine, and drive them from your own apps.
				</p>
				<p class="mt-6 max-w-(--container-measure) text-lead text-midnight-2">
					Kantel runs the model loop, the sandbox, browsers, connections and approvals, and keeps an audit trail of
					all of it. Your apps use it through the API. The console comes with it, for the people working alongside
					the agents.
				</p>
				<div class="mt-10">
					<InstallCommand id="install-hero" />
					<p class="mt-4 max-w-(--container-hero) text-sm text-label">
						Needs Docker. Paste it into bash, zsh or fish: it builds Kantel, starts it in Docker on this machine
						and opens the console. <a class="underline underline-offset-4 hover:text-midnight" href="/install.sh"
							>Read the script</a
						> first if you like, or <a
							class="underline underline-offset-4 hover:text-midnight"
							href="/docs/console/getting-started/install/">install it by hand</a
						>.
					</p>
				</div>
			</div>
			<div class="relative h-48 sm:h-72 lg:col-span-4 lg:h-auto">
				<Lever class="absolute inset-0 h-full w-full" />
			</div>
		</div>
	</section>

	<!-- After the installer: a real sequence, so numbered. -->
	<section class="border-t border-line bg-card" aria-labelledby="after-install">
		<div class="mx-auto max-w-(--container-page) px-6 py-20 lg:px-12 lg:py-28">
			<div class="max-w-(--container-hero)">
				<h2 id="after-install" class="font-display text-display-m font-semibold text-balance">
					One command, then you're in the console
				</h2>
				<p class="mt-5 max-w-(--container-measure) text-lead text-midnight-2">
					The installer starts Kantel's gateway, which serves the API and the console, with Postgres, object storage
					and a local mailbox for sign-in codes. Everything listens on 127.0.0.1 only.
				</p>
			</div>

			<div class="mt-20 space-y-28 lg:space-y-36">
				<Feature
					id="console"
					step={1}
					title="Sign in to your own console"
					route="GET /v1/me"
					docs={{ href: "/docs/console/getting-started/tour/", label: "A tour of the console" }}
					shot={consoleShot}
					alt="The Kantel console: projects and their sessions in the sidebar, grouped into Working and Done, and a session open beside it running a test fifty times in a terminal."
				>
					<p>
						Kantel is invite-only, even on your laptop. The installer invites you as the organisation's admin; sign
						in with the six-digit code from the local mailbox.
					</p>
					<p>The sidebar holds your projects, each with its sessions grouped by what they need from you.</p>
				</Feature>

				<Feature
					id="onboarding"
					step={2}
					title="Connect a model and your first tools"
					route="GET /v1/onboarding"
					docs={{ href: "/docs/console/models/", label: "Models and providers" }}
					shot={onboarding}
					alt="Kantel's first-run setup, step 1 of 3, Connect a model: a Claude subscription signed in, ChatGPT to sign in to, and API keys to add for Anthropic, OpenAI, OpenRouter and Vercel AI Gateway."
				>
					<p>
						The first visit runs a short setup. Sign in with a Claude or ChatGPT subscription, or add an API key for
						Anthropic, OpenAI, OpenRouter or any OpenAI-compatible server. Then pick the first services your agents
						may use, such as GitHub or Linear.
					</p>
					<p>Each step is an API call, so a script or a packaged agent can do the same setup without the console.</p>
					<Fragment slot="after">
						<Shot
							src={onboardingConnectors}
							alt="Step 2 of 3, Add connectors: GitHub, Linear, Notion, Slack, Google Drive, Sentry, Stripe and Salesforce, each with a Connect button."
							class="mt-6 max-w-2xl lg:mt-8 lg:ml-auto"
						/>
					</Fragment>
				</Feature>

				<Feature
					id="first-session"
					step={3}
					title="Hand an agent its first task"
					route="POST /v1/sessions"
					docs={{ href: "/docs/console/getting-started/first-steps/", label: "First steps" }}
					shot={session}
					alt="A Kantel session: the agent has been working for twelve minutes and is writing a Python script, shown line by line in an editor card."
				>
					<p>
						A session is one conversation with an agent, with its own workspace of files and a sandbox for its
						commands. You watch it work: files as they're written, commands as they run.
					</p>
				</Feature>
			</div>
		</div>
	</section>

	<!-- What you have once it's running. Not a sequence, so no numbers. -->
	<section class="border-t border-line" aria-labelledby="running">
		<div class="mx-auto max-w-(--container-page) px-6 py-20 lg:px-12 lg:py-28">
			<div class="max-w-(--container-hero)">
				<h2 id="running" class="font-display text-display-m font-semibold text-balance">
					What your agents get, and what you keep
				</h2>
				<p class="mt-5 max-w-(--container-measure) text-lead text-midnight-2">
					Agents get real tools: a sandbox, browsers and your services. You keep the say over each of them, and a
					record of every call.
				</p>
			</div>

			<div class="mt-20 space-y-28 lg:space-y-36">
				<Feature
					id="sessions"
					title="Sessions you can follow, steer and fork"
					route="GET /v1/sessions/{id}/stream"
					docs={{ href: "/docs/console/sessions/", label: "Sessions" }}
					shot={question}
					alt="A Kantel session waiting for an answer: the agent drafted a weekly digest and asks where to post it, with three options."
				>
					<p>
						Stream a session's transcript as it happens. Steer it mid-run, queue a follow-up, or fork it from any
						message. When an agent needs an answer it asks, and the session waits under Needs you.
					</p>
				</Feature>

				<Feature
					id="browsers"
					title="Browsers you can watch"
					route="POST /v1/sessions/{id}/browsers/{browser}/embed"
					docs={{ href: "/docs/console/browsers/", label: "Browsers" }}
					shot={browser}
					alt="Kantel's browser window replaying an agent's browsing: a tab for each site it opened, a read-only address bar, the page and replay controls."
				>
					<p>
						An agent asks for a browser and names the sites it needs; a person decides. Watch it live from the
						session, or replay it afterwards. A step towards a site outside the grant is refused before the browser
						moves.
					</p>
					<p>Your app can embed the same live view in its own pages.</p>
				</Feature>

				<Feature
					id="connections"
					title="Connections, with rules and approvals"
					route="PATCH /v1/connections/{id}/rules"
					docs={{ href: "/docs/console/connectors/", label: "Connections" }}
					shot={connections}
					alt="The Connections page: Gmail, GitHub, Stripe, Linear and Notion, each with who it's shared with, what it allows and when it was last used."
				>
					<p>
						Connect GitHub, Linear, Notion, Stripe or any remote MCP server once. Agents use them through tools that
						run on Kantel's side, so the token never reaches the agent.
					</p>
					<p>
						Rules say what agents may do with each connection: reads allowed, writes ask. A call that asks waits for
						a person in the session.
					</p>
					<Fragment slot="after">
						<Shot
							src={approval}
							alt="An approval card in a session: the agent asks to create a Linear API key, with the host, methods, path and a binding code to check."
							class="mt-6 max-w-lg lg:mt-8 lg:ml-auto"
						/>
					</Fragment>
				</Feature>

				<Feature
					id="vault"
					title="A vault the agent can't read"
					route="GET /v1/connection-approvals/requests"
					docs={{ href: "/docs/console/connection-requests/", label: "Connection requests" }}
					shot={vault}
					alt="A connection request: an agent asks for a Linear API key for one path, and the person narrows the methods and lifetime, picks the binding code and approves with a passkey."
				>
					<p>
						Credentials sit in Kantel's encrypted store. An agent that needs one asks with its terms: the host,
						methods, path, lifetime and number of uses. You narrow them, check the binding code against the
						session's card, and approve with a passkey.
					</p>
					<p>Kantel adds the credential to matching requests on the way out. The agent never sees the value.</p>
				</Feature>

				<Feature
					id="code-mode"
					title="Code mode: one script, many tool calls"
					route="POST /v1/programs/{id}/runs"
					docs={{ href: "/docs/api/programs/", label: "Code mode and programs" }}
					shot={codemode}
					alt="A code mode script in a session: one script that made nine GitHub requests, all allowed by the connection's rules, with the script and its output."
				>
					<p>
						Every session with tools also gets <code class="font-mono text-base">codemode</code>. The model writes a
						JavaScript script that calls the session's other tools, in an isolate with no secrets and no network.
						Each call gets the same rules, approvals and audit as a direct one.
					</p>
					<p>Save a script as a program, and your app can run it through the API with no model at all.</p>
				</Feature>
			</div>
		</div>
	</section>

	<!-- Headless first: the one midnight plate. -->
	<section class="bg-midnight text-paper" aria-labelledby="api">
		<div class="mx-auto grid max-w-(--container-page) grid-cols-1 gap-12 px-6 py-20 lg:grid-cols-12 lg:px-12 lg:py-28">
			<div class="lg:col-span-5">
				<p class="font-mono text-sm text-faint">/v1</p>
				<h2 id="api" class="mt-3 font-display text-display-m font-semibold text-balance">
					The API is the way in. The console is one client of it.
				</h2>
				<p class="mt-5 text-lead text-faint">
					Everything the console does, your app can do through the same public API: create a session, stream what
					the agent does, answer its requests and read the result. The TypeScript SDK is generated from the routes,
					one file with no dependencies.
				</p>
				<ul class="mt-8 space-y-3 text-body">
					<li><a class="underline decoration-midnight-2 underline-offset-4 hover:decoration-paper" href="/docs/api/quick-start/">Quick start</a></li>
					<li><a class="underline decoration-midnight-2 underline-offset-4 hover:decoration-paper" href="/docs/api/streaming/">Streaming a session</a></li>
					<li><a class="underline decoration-midnight-2 underline-offset-4 hover:decoration-paper" href="/docs/api/host-apps/">Building a host app</a></li>
				</ul>
			</div>
			<div class="min-w-0 lg:col-span-7">
				<pre
					class="overflow-x-auto rounded-card bg-midnight-2 p-6 font-mono text-sm leading-relaxed text-paper"><code>{`import { createKantelClient } from "@kantel/api/sdk";

const kantel = createKantelClient({
  baseUrl: \`\${process.env.KANTEL_URL}/v1\`,
  token: process.env.KANTEL_API_KEY,
});

const session = await kantel.createSession({
  projectId: "PROJECT_ID",
  agentId: "assistant",
  title: "Summarise the README",
  message: { text: "Summarise README.md in three bullet points." },
});`}</code></pre>
				<pre
					class="mt-4 overflow-x-auto rounded-card border border-midnight-2 p-6 font-mono text-sm leading-relaxed text-paper"><code>{`curl -s -G "$KANTEL_URL/v1/sessions/SESSION_ID/result" \\
  -H "authorization: Bearer $KANTEL_API_KEY" \\
  --data-urlencode "submission=SUBMISSION_ID"`}</code></pre>
			</div>
		</div>
	</section>

	<!-- Packaged agents, and what sits on top. -->
	<section aria-labelledby="packaged">
		<div class="mx-auto grid max-w-(--container-page) grid-cols-1 gap-12 px-6 py-20 lg:grid-cols-12 lg:px-12 lg:py-28">
			<div class="lg:col-span-5">
				<h2 id="packaged" class="font-display text-display-m font-semibold text-balance">Agents packaged on Kantel</h2>
				<p class="mt-5 text-lead text-midnight-2">
					On Kantel an agent isn't a program you deploy. It's a profile, its skills and memory, and the tools your
					app serves, and Kantel runs the loop.
				</p>
				<p class="mt-4 text-body text-midnight-2">
					Personal agents such as Sal and Erys are packaged this way, and Lleverage's own product sits on top of
					Kantel. Yours can too.
				</p>
				<a
					href="/docs/api/packaging-an-agent/"
					class="mt-6 inline-block border-b border-line pb-0.5 font-semibold transition-colors hover:border-midnight"
					>Packaging an agent</a
				>
			</div>
			<div class="lg:col-span-7" role="img" aria-label="Lleverage, Sal, Erys and your own app each sit on Kantel's API, which runs on Kantel's sessions, sandbox, browsers, connections, vault and audit, on your machine, your servers or Cloudflare.">
				<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
					{
						["Lleverage", "Sal", "Erys", "Your app"].map((name) => (
							<div class="rounded-tile border border-card-line bg-card px-4 py-5 text-center font-semibold">{name}</div>
						))
					}
				</div>
				<div class="mt-3 rounded-tile border-t-4 border-orange bg-card px-5 py-4">
					<p class="font-semibold">Kantel's API</p>
					<p class="font-mono text-sm text-label">/v1: sessions, streams, approvals, programs</p>
				</div>
				<div class="mt-3 rounded-tile bg-midnight px-5 py-5 text-paper">
					<p class="font-semibold">Kantel</p>
					<p class="mt-1 text-sm text-faint">
						Model loop, sandbox, browsers, connections, vault, skills, memory, schedules and audit
					</p>
				</div>
				<p class="mt-3 text-center text-sm text-label">On your machine, your own servers or Cloudflare</p>
			</div>
		</div>
	</section>

	<!-- Docs and source. -->
	<section class="border-t border-line bg-card" aria-labelledby="docs">
		<div class="mx-auto grid max-w-(--container-page) grid-cols-1 gap-12 px-6 py-20 lg:grid-cols-12 lg:px-12 lg:py-28">
			<div class="lg:col-span-7">
				<h2 id="docs" class="font-display text-display-m font-semibold">Read the docs</h2>
				<ul class="mt-8 divide-y divide-line border-y border-line">
					{
						docSections.map((section) => (
							<li>
								<a href={section.href} class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
									<span class="font-semibold group-hover:underline group-hover:underline-offset-4">{section.title}</span>
									<span class="text-sm text-label">{section.text}</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div class="lg:col-span-5">
				<h2 class="font-display text-display-m font-semibold">Or the source</h2>
				<p class="mt-5 text-body text-midnight-2">
					Kantel is open source under the Apache License 2.0. Read it, run it, change it.
				</p>
				<a
					href={GITHUB_URL}
					class="mt-6 inline-flex items-center gap-3 rounded-input border border-midnight px-4 py-3 font-mono text-sm transition-colors hover:bg-midnight hover:text-paper"
					>github.com/{repo}</a
				>
				<div class="mt-12">
					<p class="mb-3 text-sm font-semibold">Install it</p>
					<InstallCommand id="install-foot" compact />
				</div>
			</div>
		</div>
	</section>
</Base>
