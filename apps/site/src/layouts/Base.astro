---
// The marketing page's shell: head, the header with the endorsed lockup and the theme toggle, and the footer.
import "../styles/site.css";
import lockupEndorsed from "../assets/brand/kantel-lockup-endorsed-on-light.svg?raw";
import ThemeToggle from "../components/ThemeToggle.astro";
import { CONSOLE_URL, GITHUB_URL, LLEVERAGE_URL, SITE_URL } from "../site.mjs";

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
// The light lockup, with its ink as currentColor so it takes the theme's (text-ink); the orange stays.
const lockup = lockupEndorsed
	.replace("<svg ", '<svg class="h-full w-auto" ')
	.replaceAll('fill="#252820"', 'fill="currentColor"');
---

<!doctype html>
<html lang="en-GB" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- The theme before first paint, so a dark page never flashes paper: the person's choice under Starlight's key
		     (shared with the docs), else the device's. ThemeToggle keeps it in step afterwards. -->
		<script is:inline>
			(() => {
				let theme = null;
				try {
					theme = localStorage.getItem("starlight-theme");
				} catch {}
				if (theme !== "light" && theme !== "dark") {
					theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
				}
				document.documentElement.dataset.theme = theme;
			})();
		</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL(Astro.url.pathname, SITE_URL)} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#f9f7f0" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#141e28" media="(prefers-color-scheme: dark)" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={SITE_URL} />
	</head>
	<body class="min-h-screen overflow-x-clip bg-paper text-midnight">
		<a
			href="#main"
			class="sr-only rounded-input bg-midnight px-4 py-2 text-paper focus:not-sr-only focus:absolute focus:top-4 focus:left-4"
			>Skip to the content</a
		>
		<header class="sticky top-0 z-20 border-b border-transparent bg-paper/90 backdrop-blur-sm">
			<nav
				class="mx-auto flex max-w-(--container-page) items-center justify-between gap-3 px-4 py-4 xs:gap-4 xs:px-6 sm:gap-6 lg:px-12"
			>
				<a href="/" class="block h-5.5 shrink-0 text-ink xs:h-7 sm:h-8" aria-label="Kantel, by Lleverage: home" set:html={lockup} />
				<ul class="flex items-center gap-2 text-sm font-semibold xs:gap-3 sm:gap-8 sm:text-base">
					<li><a class="hover:text-label" href="/docs/">Docs</a></li>
					<li class="hidden sm:block"><a class="hover:text-label" href={GITHUB_URL}>GitHub</a></li>
					<li>
						<a
							class="inline-block rounded-input border border-midnight px-2.5 py-1.5 xs:px-3 transition-colors hover:bg-midnight hover:text-paper"
							href={CONSOLE_URL}>Console</a
						>
					</li>
					<li class="flex"><ThemeToggle /></li>
				</ul>
			</nav>
		</header>

		<main id="main" class="overflow-x-clip"><slot /></main>

		<footer class="border-t border-line">
			<div
				class="mx-auto grid max-w-(--container-page) grid-cols-1 gap-10 px-6 py-14 text-sm text-label sm:grid-cols-2 lg:grid-cols-4 lg:px-12"
			>
				<div class="sm:col-span-2">
					<div class="h-7 text-ink" set:html={lockup} />
					<p class="mt-4 max-w-sm">
						Kantel is made by <a class="underline underline-offset-4 hover:text-midnight" href={LLEVERAGE_URL}
							>Lleverage</a
						> and released under the Apache License 2.0.
					</p>
				</div>
				<ul class="space-y-2">
					<li><a class="hover:text-midnight" href="/docs/quickstart/">Quick start</a></li>
					<li><a class="hover:text-midnight" href="/docs/own-hosts/">Add a host</a></li>
					<li><a class="hover:text-midnight" href="/docs/self-hosting/install/">Self-host Kantel</a></li>
					<li><a class="hover:text-midnight" href="/docs/api/reference/">API reference</a></li>
				</ul>
				<ul class="space-y-2">
					<li><a class="hover:text-midnight" href={GITHUB_URL}>Source on GitHub</a></li>
					<li><a class="hover:text-midnight" href="/install.sh">install.sh</a></li>
					<li><a class="hover:text-midnight" href={LLEVERAGE_URL}>lleverage.ai</a></li>
				</ul>
			</div>
		</footer>
	</body>
</html>
