// kantel.dev as a Workers static-assets Worker: no Worker code, only the built site in dist/ (`pnpm build`).
// Not deployed yet. To host it, from apps/site with a token for the account that holds the kantel.dev zone:
//   pnpm build && pnpm exec wrangler deploy
// The custom domain below makes Cloudflare create kantel.dev's DNS record and certificate on that first deploy.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "kantel-site",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		// /docs/console/models/ serves dist/docs/console/models/index.html; /install.sh is served as itself.
		"html_handling": "auto-trailing-slash",
		// An unknown path gets dist/404.html (Starlight's), with a 404 status.
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "kantel.dev", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": false }
}
