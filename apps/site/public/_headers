# Workers static assets read this file for response headers (it isn't served itself).

# Shown as text in a browser, so people can read it before piping it to sh; curl doesn't mind.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# The docs for language models (scripts/llms-txt.mjs), as UTF-8 text.
/docs/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/docs/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
