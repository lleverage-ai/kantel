diff -ruN orig/serde_v8-0.321.0/sandbox.rs patched/serde_v8-0.321.0/sandbox.rs
--- orig/serde_v8-0.321.0/sandbox.rs	1970-01-01 01:00:00.000000000 +0100
+++ patched/serde_v8-0.321.0/sandbox.rs	2026-11-11 02:27:14.527088786 +0100
@@ -0,0 +1,61 @@
+// Kantel patch: ArrayBuffers for bytes made in Rust, allocated by the isolate's own ArrayBuffer allocator and copied
+// into, instead of wrapping Rust's heap memory (new_backing_store_from_vec/_boxed_slice/_bytes). With V8's sandbox on,
+// a backing store must be inside the sandbox, so rusty_v8 leaves the wrapping constructors out of sandbox builds;
+// and with a budget allocator the bytes count against the isolate's memory limit. Costs one copy per buffer.
+//
+// The allocation is fallible: when the isolate's budget is spent, this throws a RangeError in the isolate and
+// answers an empty ArrayBuffer, instead of V8's default of crashing the process. It needs
+// kantel__ArrayBuffer__NewBackingStore__or_null from Kantel's rusty_v8 build
+// (apps/host/isolate-runtime/v8/patches/rusty_v8-150.4.0-budget-allocator.patch).
+
+unsafe extern "C" {
+  fn kantel__ArrayBuffer__NewBackingStore__or_null(
+    isolate: v8::UnsafeRawIsolatePtr,
+    byte_length: usize,
+  ) -> *mut v8::BackingStore;
+}
+
+/// A backing store of `byte_length` uninitialised bytes from the isolate's allocator, or None if it refuses.
+pub fn try_new_backing_store(
+  isolate: &v8::Isolate,
+  byte_length: usize,
+) -> Option<v8::UniqueRef<v8::BackingStore>> {
+  // SAFETY: the isolate is live (we hold a reference); the function returns an owned BackingStore or null.
+  let mut ptr = unsafe {
+    v8::UniquePtr::from_raw(kantel__ArrayBuffer__NewBackingStore__or_null(
+      isolate.as_raw_isolate_ptr(),
+      byte_length,
+    ))
+  };
+  ptr.take()
+}
+
+/// An ArrayBuffer holding a copy of `bytes`, or (budget spent) an empty one with a RangeError thrown.
+pub fn new_array_buffer<'s, 'i>(
+  scope: &mut v8::PinScope<'s, 'i>,
+  bytes: &[u8],
+) -> v8::Local<'s, v8::ArrayBuffer> {
+  if bytes.is_empty() {
+    return v8::ArrayBuffer::new(scope, 0);
+  }
+  let Some(store) = try_new_backing_store(scope, bytes.len()) else {
+    let msg = v8::String::new(scope, "Array buffer allocation failed: the isolate's memory limit").unwrap();
+    let exc = v8::Exception::range_error(scope, msg);
+    scope.throw_exception(exc);
+    return v8::ArrayBuffer::new(scope, 0);
+  };
+  let data = store.data().expect("non-empty backing store has data");
+  // SAFETY: the store is `bytes.len()` bytes long and nothing else refers to it yet.
+  unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), data.as_ptr() as *mut u8, bytes.len()) };
+  v8::ArrayBuffer::with_backing_store(scope, &store.make_shared())
+}
+
+/// The same for a slice of plain numbers (typed arrays' element types).
+pub fn new_array_buffer_of<'s, 'i, T: Copy>(
+  scope: &mut v8::PinScope<'s, 'i>,
+  items: &[T],
+) -> v8::Local<'s, v8::ArrayBuffer> {
+  // SAFETY: T is a plain number type (u8..u64, i8..i64, f32, f64): any bit pattern of its bytes is valid to read.
+  let bytes = unsafe { std::slice::from_raw_parts(items.as_ptr() as *const u8, std::mem::size_of_val(items)) };
+  new_array_buffer(scope, bytes)
+}
