+// Kantel: an ArrayBuffer allocator with a byte budget, one per isolate. The memory comes from V8's default allocator,
+// so with the V8 sandbox on it is inside the sandbox (a RustAllocator's malloc'd memory isn't, which is why rusty_v8
+// leaves RustAllocator out of sandbox builds). The budget is the only thing it adds: an allocation that would take
+// the isolate's ArrayBuffers past `limit` bytes fails, and JS gets a RangeError.
+class KantelBudgetAllocator final : public v8::ArrayBuffer::Allocator {
+ public:
+  explicit KantelBudgetAllocator(size_t limit)
+      : inner_(v8::ArrayBuffer::Allocator::NewDefaultAllocator()),
+        limit_(limit) {}
+  KantelBudgetAllocator(const KantelBudgetAllocator&) = delete;
+  void operator=(const KantelBudgetAllocator&) = delete;
+  ~KantelBudgetAllocator() override { delete inner_; }
+
+  void* Allocate(size_t length) override {
+    if (!Reserve(length)) return nullptr;
+    void* data = inner_->Allocate(length);
+    if (data == nullptr) Release(length);
+    return data;
+  }
+  void* AllocateUninitialized(size_t length) override {
+    if (!Reserve(length)) return nullptr;
+    void* data = inner_->AllocateUninitialized(length);
+    if (data == nullptr) Release(length);
+    return data;
+  }
+  void Free(void* data, size_t length) override {
+    if (data == nullptr) return;
+    inner_->Free(data, length);
+    Release(length);
+  }
+  size_t MaxAllocationSize() const override {
+    return std::min(limit_, inner_->MaxAllocationSize());
+  }
+  v8::PageAllocator* GetPageAllocator() override {
+    return inner_->GetPageAllocator();
+  }
+  size_t used() const { return used_.load(std::memory_order_relaxed); }
+
+ private:
+  // Never past the limit, and no overflow: the check is `length <= limit - used`.
+  bool Reserve(size_t length) {
+    size_t used = used_.load(std::memory_order_relaxed);
+    do {
+      if (length > limit_ - used) return false;
+    } while (!used_.compare_exchange_weak(used, used + length,
+                                          std::memory_order_relaxed));
+    return true;
+  }
+  void Release(size_t length) {
+    used_.fetch_sub(length, std::memory_order_relaxed);
+  }
+
+  v8::ArrayBuffer::Allocator* inner_;
+  const size_t limit_;
+  std::atomic<size_t> used_{0};
+};
+
+v8::ArrayBuffer::Allocator* kantel__BudgetAllocator__New(size_t limit) {
+  return new KantelBudgetAllocator(limit);
+}
+
+size_t kantel__BudgetAllocator__Used(const v8::ArrayBuffer::Allocator* self) {
+  return static_cast<const KantelBudgetAllocator*>(self)->used();
+}
