+/// Kantel patch: a few numbers shared with JS through a typed array. The memory comes from the isolate's ArrayBuffer
+/// allocator, so with V8's sandbox on it is inside the sandbox. It was a Box on Rust's heap handed to JS with
+/// new_backing_store_from_ptr, which the sandbox forbids: JS could then write to Rust's heap.
+pub(crate) struct SharedInfo<T: Copy, const N: usize> {
+  pub(crate) store: v8::SharedRef<v8::BackingStore>,
+  ptr: *mut [T; N],
+}
+
+impl<T: Copy, const N: usize> SharedInfo<T, N> {
+  fn new(isolate: &mut v8::Isolate) -> Self {
+    // Zero-initialised by the allocator; size_of is a few bytes, far under any budget.
+    let store = v8::ArrayBuffer::new_backing_store(isolate, std::mem::size_of::<[T; N]>()).make_shared();
+    let ptr = store.data().expect("shared info store").as_ptr() as *mut [T; N];
+    Self { store, ptr }
+  }
+}
+
+impl<T: Copy, const N: usize> std::ops::Deref for SharedInfo<T, N> {
+  type Target = [T; N];
+  fn deref(&self) -> &[T; N] {
+    // SAFETY: `store` keeps the memory alive and is suitably aligned (V8 allocates at least 8-byte aligned). JS
+    // writes it only on this thread, between Rust's reads, as with the Box before.
+    unsafe { &*self.ptr }
+  }
+}
