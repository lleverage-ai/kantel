[Unit]
Description=workerd running Kantel's isolate worker
After=kantel-guest.service

[Service]
User=workerd
WorkingDirectory=/opt/kantel-isolate
ExecStart=/usr/local/bin/workerd serve config.capnp --experimental
Restart=always
RestartSec=200ms
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
