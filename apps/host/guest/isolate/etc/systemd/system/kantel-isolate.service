# Kantel's isolate runtime (kantel-isolate: deno_core and V8). Every sandbox of the VM's account is a V8 isolate in
# this one process. It reaches nothing but the host's blob store and egress proxy, through the guest agent's bridges
# on 127.0.0.1:7001 and 7002 (kantel-guest.service.d/bridges.conf), and serves kantel-host on 127.0.0.1:8080, which
# the host reaches over vsock. Its assets (/opt/kantel-isolate) are read-only.
#
# The runtime's own hardening (V8's sandbox, seccomp and landlock in the process) is the runtime's; this unit is the
# systemd half: an unprivileged user, no capabilities, nothing writable but its private /tmp.
[Unit]
Description=Kantel isolate runtime (kantel-isolate)
After=kantel-guest.service

[Service]
User=kantel-isolate
Group=kantel-isolate
WorkingDirectory=/opt/kantel-isolate
ExecStart=/usr/local/bin/kantel-isolate serve --listen 127.0.0.1:8080 --store http://127.0.0.1:7001 --egress http://127.0.0.1:7002 --assets /opt/kantel-isolate
Restart=always
RestartSec=200ms
# The VM's memory is its account's isolates' together. If it runs out, the kernel ends the runtime (systemd starts it
# again, and a sandbox's state is its manifest, on the host), never the guest agent the host reaches the VM through.
OOMScoreAdjust=500
LimitNOFILE=65536
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
# V8 compiles code at run time, writing pages it then makes executable, so MemoryDenyWriteExecute stays off.
SystemCallFilter=@system-service
SystemCallFilter=~@mount @privileged @reboot @swap @module @raw-io @obsolete @cpu-emulation @debug
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
