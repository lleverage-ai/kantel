#!/bin/bash
# kantel-apt-snapshot-check: run by apt before every update (APT::Update::Pre-Invoke, written by kantel-apt-sources to
# /etc/apt/apt.conf.d/60kantel-snapshot-check). It asks snapshot.ubuntu.com for the snapshot's InRelease, through the
# same apt settings (and so the same egress proxy) the update uses, and:
#   - when the snapshot answers, removes /etc/apt/preferences.d/kantel-snapshot-down, so the snapshot (500) comes first
#     again over the live archive (100);
#   - when it doesn't, writes that file, which pins the snapshot down to 1, under the live archive.
# The pin is what makes the fallback hold once a sandbox has read the snapshot before: when an update can't fetch a
# source's indexes, apt keeps the ones it already had, so without it apt would go on choosing the snapshot's versions
# from them and fail to download any the live archive has moved past (lleverage-ai/kantel#706). A version both have
# still downloads from either. The pin changes which version apt picks, not what it trusts: every source is checked
# against Ubuntu's archive key as before.
#
# It never fails the update: apt runs it as `kantel-apt-snapshot-check || true`, and it exits 0 whatever happens.
# KANTEL_APT_ROOT reads and writes under another root, and KANTEL_APT_HELPER names apt-helper (tests).
set -uo pipefail

root=${KANTEL_APT_ROOT:-}
helper=${KANTEL_APT_HELPER:-/usr/lib/apt/apt-helper}
pin=$root/etc/apt/preferences.d/kantel-snapshot-down

uri=$(sed -n 's|^URIs: \(https://snapshot\.ubuntu\.com/ubuntu/[0-9]\{8\}T[0-9]\{6\}Z/\)$|\1|p' \
	"$root/etc/apt/sources.list.d/ubuntu.sources" 2>/dev/null | head -n 1)
# shellcheck source=/dev/null
codename=$(. "$root/etc/os-release" 2>/dev/null && echo "${VERSION_CODENAME:-}")
if [[ -z $uri || -z $codename ]]; then
	exit 0
fi

tmp=$(mktemp -d) || exit 0
trap 'rm -rf "$tmp"' EXIT
# apt-helper downloads as _apt when it can, which needs to write here.
chown _apt "$tmp" 2>/dev/null || true
# One quick try: the update that follows has its own retries, and this only decides the pin.
if "$helper" -o Acquire::Retries=0 -o Acquire::http::Timeout=15 -o Acquire::https::Timeout=15 \
	download-file "${uri}dists/$codename/InRelease" "$tmp/InRelease" >"$tmp/log" 2>&1; then
	if [[ -e $pin ]]; then
		rm -f "$pin"
		echo "kantel: snapshot.ubuntu.com answers again, so apt prefers Ubuntu's snapshot over the live archive again."
	fi
	exit 0
fi

mkdir -p "$(dirname "$pin")" 2>/dev/null || exit 0
{
	echo "# Written by kantel-apt-snapshot-check before an apt update, when snapshot.ubuntu.com didn't answer: the snapshot"
	echo "# comes under the live archive until an update finds it again, when this file goes (lleverage-ai/kantel#706)."
	printf '\nPackage: *\nPin: origin snapshot.ubuntu.com\nPin-Priority: 1\n'
} >"$pin" 2>/dev/null || exit 0
# apt-helper says why on the line after its Err: line, such as "503  Service Unavailable [IP: 10.231.0.9 3129]".
reason=$(sed -n '/^Err:/{n;s/^ *//;p;q;}' "$tmp/log" 2>/dev/null | cut -c 1-200)
echo "kantel: snapshot.ubuntu.com isn't answering${reason:+ ($reason)}, so apt takes Ubuntu's packages from the live archive until an update finds it again ($pin)."
exit 0
