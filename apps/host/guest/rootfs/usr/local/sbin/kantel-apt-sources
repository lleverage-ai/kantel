#!/bin/bash
# kantel-apt-sources [SNAPSHOT]: Ubuntu's apt sources for what a sandbox installs, the snapshot first and the live
# archive when the snapshot can't give a package.
#
# The image is built from Ubuntu's archive as it was at SNAPSHOT (APT::Snapshot, /etc/apt/apt.conf.d/50kantel-snapshot;
# the default is the one there). Inside a sandbox, apt reads both:
#   - https://snapshot.ubuntu.com/ubuntu/SNAPSHOT/ at the usual priority (500), so a package the snapshot has comes
#     from it, as the image's own did;
#   - the live archive (archive.ubuntu.com and security.ubuntu.com, or ports.ubuntu.com on arm64) at priority 100
#     (/etc/apt/preferences.d/kantel-ubuntu-live), which apt takes a package from only when no source of priority 500
#     has a version it can install: when snapshot.ubuntu.com is failing (it answered 503 for hours on 5 Nov 2026,
#     lleverage-ai/kantel#706), and for the packages the image's security refresh already took past the snapshot.
# Every source is "Snapshot: disable": the snapshot is named outright, and APT::Snapshot still holds the other
# archives (Debian's, for Chromium, and any PPA) at SNAPSHOT.
#
# KANTEL_APT_ROOT writes under another root, and KANTEL_APT_ARCH names the architecture (tests).
set -euo pipefail

root=${KANTEL_APT_ROOT:-}
snapshot=${1:-$(sed -n 's/^APT::Snapshot "\(.*\)";/\1/p' "$root/etc/apt/apt.conf.d/50kantel-snapshot" 2>/dev/null || true)}
if ! [[ $snapshot =~ ^[0-9]{8}T[0-9]{6}Z$ ]]; then
	echo "kantel-apt-sources: the snapshot must be an ID such as 20261103T000000Z, not \"$snapshot\"" >&2
	exit 2
fi
arch=${KANTEL_APT_ARCH:-$(dpkg --print-architecture)}
# shellcheck source=/dev/null
codename=$(. "$root/etc/os-release" && echo "${VERSION_CODENAME:?}")

case $arch in
amd64 | i386)
	live=http://archive.ubuntu.com/ubuntu/
	security=http://security.ubuntu.com/ubuntu/
	;;
*)
	live=http://ports.ubuntu.com/ubuntu-ports/
	security=$live
	;;
esac

stanza() { # stanza URI SUITES...
	local uri=$1
	shift
	printf '%s\n' 'Types: deb' "URIs: $uri" "Suites: $*" 'Components: main universe restricted multiverse' \
		'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' 'Snapshot: disable'
}

host() { # host URI
	local rest=${1#*://}
	echo "${rest%%/*}"
}

{
	echo "# Written by kantel-apt-sources: Ubuntu as it was at $snapshot first, the live archive when that can't"
	echo "# give a package (see /usr/local/sbin/kantel-apt-sources). Run it again with another snapshot ID to move."
	echo
	stanza "https://snapshot.ubuntu.com/ubuntu/$snapshot/" "$codename" "$codename-updates" "$codename-backports" \
		"$codename-security"
	echo
	if [[ $security == "$live" ]]; then
		stanza "$live" "$codename" "$codename-updates" "$codename-backports" "$codename-security"
	else
		stanza "$live" "$codename" "$codename-updates" "$codename-backports"
		echo
		stanza "$security" "$codename-security"
	fi
} >"$root/etc/apt/sources.list.d/ubuntu.sources"

hosts=("$(host "$live")")
[[ $security == "$live" ]] || hosts+=("$(host "$security")")
mkdir -p "$root/etc/apt/preferences.d"
{
	echo "# Written by kantel-apt-sources: the live archive only where the snapshot can't give a package."
	for h in "${hosts[@]}"; do
		printf '\nPackage: *\nPin: origin %s\nPin-Priority: 100\n' "$h"
	done
} >"$root/etc/apt/preferences.d/kantel-ubuntu-live"
