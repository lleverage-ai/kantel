#!/bin/sh
# The desktop in a browser: Selkies on loopback port 6080, one HTTP port serving its web client and the stream
# (H.264 encoded on the CPU, over a WebSocket), so it needs no GPU, no UDP and no TURN: the host's relay carries it
# as it carries SSH. It has no login of its own: only the host reaches the port (over vsock), and the relay in front
# of it checks the signed URL.
#
# - The viewer sizes the desktop: its window's size times its device pixel ratio becomes the display's (RandR on
#   Xvnc, kantel-desktop), so the picture is drawn one stream pixel per screen pixel, sharp on a HiDPI screen too,
#   rather than a fixed 1920x1080 scaled to fit. kantel-selkies holds each request to a pixel budget
#   (KANTEL_STREAM_MAX_PIXELS), so a large HiDPI window can't ask a small sandbox to encode 4K. KANTEL_DESKTOP_SIZE is
#   the size until a viewer resizes it.
# - Changes only: with Selkies' Turbo mode off it encodes what changed and paints a still screen over sharp, instead
#   of encoding every frame (a watched still desktop drops from about two cores to a third of one on 4 vCPUs).
# - 4:4:4 colour, so small and coloured text stays crisp (a browser that can't decode it gets 4:2:0).
# - No overlay (sidebar, logo, buttons): the console's page has the controls.
# KANTEL_STREAM_FLAGS (desktop.env) comes last, so it overrides any of these.
export DISPLAY=:1
for _ in $(seq 200); do [ -e /tmp/.X11-unix/X1 ] && break; sleep 0.05; done
exec kantel-selkies --addr=127.0.0.1 --port="${KANTEL_STREAM_PORT:-6080}" --enable-https=false --enable-basic-auth=false \
	--mode=websockets --encoder="${KANTEL_STREAM_ENCODER:-h264enc}" --use-cpu=true \
	--framerate="${KANTEL_STREAM_FPS:-60}" --enable-resize=true \
	--video-streaming-mode=false --video-fullcolor=true \
	--ui-show-sidebar=false --ui-show-logo=false --ui-show-core-buttons=false --ui-show-connection-indicator=false \
	--audio-enabled=false --microphone-enabled=false --gamepad-enabled=false --webcam-enabled=false \
	--printing-enabled=false --enable-player2=false --enable-player3=false --enable-player4=false \
	${KANTEL_STREAM_FLAGS:-}
