#!/bin/sh
# The sandbox's desktop: TigerVNC's X server on display :1 (VNC on loopback port 5901; the host reaches it over
# vsock) running an XFCE session. Chromium (kantel-browser) and the browser stream (kantel-stream, Selkies) attach to
# the same display.
export DISPLAY=:1
size=${KANTEL_DESKTOP_SIZE:-1920x1080}
rm -f /tmp/.X1-lock /tmp/.X11-unix/X1
Xvnc :1 -geometry "$size" -depth 24 -SecurityTypes None -localhost yes -rfbport 5901 -nolisten tcp \
	-AlwaysShared -AcceptSetDesktopSize -FrameRate 60 &
xvnc=$!
for _ in $(seq 100); do [ -e /tmp/.X11-unix/X1 ] && break; sleep 0.05; done
# The session ends with Xvnc, and systemd starts both again.
dbus-run-session -- xfce4-session &
session=$!
wait "$xvnc"
kill "$session" 2>/dev/null
exit 1
