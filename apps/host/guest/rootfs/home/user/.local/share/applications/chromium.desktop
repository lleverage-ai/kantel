[Desktop Entry]
Type=Application
Version=1.0
Name=Chromium
GenericName=Web browser
# Kantel: the desktop's own Chromium (kantel-chromium), apart from the sandbox's, which agents drive over CDP.
Comment=Browse the web
Exec=kantel-chromium %U
Icon=chromium
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=chromium
