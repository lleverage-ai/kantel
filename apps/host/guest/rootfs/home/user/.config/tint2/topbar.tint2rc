# Kantel's top bar (tint2, started by kantel-session): thin, at the top, with an apps button, the open windows and
# the time. The dock is a second tint2 (dock.tint2rc).

# 1: the bar
rounded = 0
border_width = 0
border_sides = B
background_color = #1b1d22 100
border_color = #2a2e36 100
background_color_hover = #1b1d22 100
border_color_hover = #2a2e36 100
background_color_pressed = #1b1d22 100
border_color_pressed = #2a2e36 100

# 2: a window's button
rounded = 4
border_width = 0
background_color = #1b1d22 0
border_color = #000000 0
background_color_hover = #2a2e36 100
border_color_hover = #000000 0
background_color_pressed = #3a3f4b 100
border_color_pressed = #000000 0

# 3: the active window's button
rounded = 4
border_width = 0
background_color = #2f333d 100
border_color = #000000 0
background_color_hover = #3a3f4b 100
border_color_hover = #000000 0
background_color_pressed = #3a3f4b 100
border_color_pressed = #000000 0

# 4: the apps button
rounded = 4
border_width = 0
background_color = #1b1d22 0
border_color = #000000 0
background_color_hover = #2a2e36 100
border_color_hover = #000000 0
background_color_pressed = #3a3f4b 100
border_color_pressed = #000000 0

panel_items = PTC
panel_size = 100% 28
panel_margin = 0 0
panel_padding = 6 2 8
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_position = top center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 0
autohide = 0
strut_policy = follow_size
panel_window_name = kantel-topbar
disable_transparency = 1
mouse_effects = 1
font_shadow = 0
mouse_hover_icon_asb = 100 0 10
mouse_pressed_icon_asb = 100 0 0

button = new
button_text = Kantel
button_tooltip = All apps
button_lclick_command = kantel-apps
button_font = DejaVu Sans Bold 10
button_font_color = #e6e8ec 100
button_padding = 8 2
button_background_id = 4
button_centered = 1
button_max_icon_size = 0

taskbar_mode = single_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 8 0 4
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
taskbar_distribute_size = 0
taskbar_sort_order = none
task_align = left
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 220 24
task_padding = 6 2 6
task_tooltip = 1
task_thumbnail = 0
task_font = DejaVu Sans 9
task_font_color = #aeb3bd 100
task_active_font_color = #ffffff 100
task_icon_asb = 100 0 0
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 3
task_iconified_background_id = 2
task_iconified_font_color = #6b707a 100
urgent_nb_of_blink = 8
mouse_left = toggle_iconify
mouse_middle = close
mouse_right = none
mouse_scroll_up = none
mouse_scroll_down = none

time1_format = %a %d %b  %H:%M
time1_font = DejaVu Sans 10
time1_timezone =
clock_font_color = #e6e8ec 100
clock_padding = 6 0
clock_background_id = 0
clock_tooltip = %A %d %B %Y, %H:%M:%S %Z
clock_lclick_command =
clock_rclick_command =
