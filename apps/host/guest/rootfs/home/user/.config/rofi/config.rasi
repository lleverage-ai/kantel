/* Kantel's app launcher (kantel-apps: the dock's first icon, the top bar's Kantel button and Super+Space): rofi's
   list of desktop entries, as a grid of icons with a search box, in the desktop's colours. */
configuration {
  modi: "drun";
  show-icons: true;
  icon-theme: "Adwaita";
  drun-display-format: "{name}";
  display-drun: "";
  terminal: "lxterminal";
  font: "DejaVu Sans 10";
  click-to-exit: true;
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
  /* No compositor: the rounded window's corners show a copy of the screen behind it. */
  fake-transparency: true;
  fake-background: "screenshot";
}

* {
  bg: #22252c;
  bg-alt: #2a2e36;
  fg: #e6e8ec;
  fg-dim: #7d828d;
  accent: #4a90e2;
  background-color: transparent;
  text-color: @fg;
}

window {
  location: center;
  anchor: center;
  width: 560px;
  background-color: @bg;
  transparency: "screenshot";
  border: 1px;
  border-color: #3a3f4b;
  border-radius: 12px;
  padding: 16px;
}

mainbox { children: [ inputbar, listview ]; spacing: 14px; }

inputbar {
  children: [ entry ];
  background-color: @bg-alt;
  border-radius: 8px;
  padding: 8px 12px;
}

entry { placeholder: "Search apps"; placeholder-color: @fg-dim; cursor: text; }

listview {
  columns: 4;
  lines: 3;
  fixed-height: false;
  fixed-columns: true;
  spacing: 6px;
  scrollbar: false;
  flow: horizontal;
  border: 0;
}

element {
  orientation: vertical;
  padding: 10px 4px;
  spacing: 6px;
  border-radius: 8px;
  cursor: pointer;
}

element normal.normal, element alternate.normal, element normal.active, element alternate.active,
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @fg; }

element selected.normal, element selected.active, element selected.urgent { background-color: @bg-alt; }

element-icon { size: 44px; horizontal-align: 0.5; cursor: inherit; }

element-text { horizontal-align: 0.5; cursor: inherit; }

element-text selected { text-color: #ffffff; }

element-icon, element-text { background-color: transparent; }
