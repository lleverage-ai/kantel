[Unit]
Description=Kantel browser: Chromium on its own display :2, DevTools (CDP) on 127.0.0.1:9222
# Its display; and the desktop's, for an image that puts it there (KANTEL_BROWSER_DISPLAY=:1).
After=kantel-browser-display.service kantel-desktop.service
Wants=kantel-browser-display.service

[Service]
User=user
Environment=HOME=/home/user XDG_RUNTIME_DIR=/run/user/1000
EnvironmentFile=-/etc/kantel/desktop.env
EnvironmentFile=-/etc/kantel/proxy.env
ExecStart=/usr/local/bin/kantel-browser
Restart=always
RestartSec=1s

[Install]
WantedBy=multi-user.target
