[Unit]
Description=Kantel desktop stream: Selkies (web client and WebSocket stream) on 127.0.0.1:6080
After=kantel-desktop.service
Wants=kantel-desktop.service
# Restarted with the desktop: Selkies keeps the display's size and DPI as it last set them, so a new X server would
# otherwise stay at 1920x1080 and 96 DPI however the viewer asks; its viewers reconnect and ask again.
PartOf=kantel-desktop.service

[Service]
User=user
Environment=HOME=/home/user XDG_RUNTIME_DIR=/run/user/1000
EnvironmentFile=-/etc/kantel/desktop.env
ExecStart=/usr/local/bin/kantel-stream
Restart=always
RestartSec=1s

[Install]
WantedBy=multi-user.target
