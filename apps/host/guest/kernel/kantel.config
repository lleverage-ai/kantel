
# Kantel additions to Firecracker's CI guest config, on every architecture: KVM inside the sandbox (nested
# virtualisation), and what Docker in the sandbox needs beyond the CI config. kantel-<arch>.config adds what only one
# architecture has (x86_64's Intel and AMD KVM).
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_VHOST_NET=y
CONFIG_VHOST_VSOCK=y
CONFIG_IP_VS=y
CONFIG_IP_VS_RR=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_BLK_CGROUP=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_POSIX_MQUEUE=y
CONFIG_VXLAN=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_DUMMY=y
CONFIG_BTRFS_FS=n
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_BINFMT_MISC=y
# Bucket mounts are a FUSE file system in the guest. Firecracker's CI config has it already; named here so build.sh
# fails if it ever doesn't.
CONFIG_FUSE_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# What Docker's check-config.sh still asks for beyond the above (Docker 29 needs the raw tables), and for
# Kubernetes-in-Docker (kind, k3d): ipsets, statistic, IPVS's protocols, nftables' fib and masquerade, and the
# overlay network's encryption.
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_MASQ=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_GHASH=y
CONFIG_INET_ESP=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_NAT_FTP=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_NAT_TFTP=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NET_SCH_FQ_CODEL=y
# Nested microVMs inside the sandbox: KVM (above), TAP devices and vhost for their networking.
CONFIG_TUN=y
CONFIG_VHOST_NET=y
# Bundle mounts: the host turns each bundle into an uncompressed erofs image and attaches it as a read-only drive,
# which the guest agent mounts (read-only, nodev, nosuid) where the sandbox asked.
CONFIG_EROFS_FS=y
