{
  "routes": [
    {
      "id": "research-site",
      "host": "research-site",
      "ports": [80],
      "methods": ["GET", "HEAD"],
      "pathPrefix": "/",
      "inject": {
        "header": "authorization",
        "template": "Bearer {secret}",
        "secretEnv": "HARBOUR_CANARY_SECRET"
      }
    },
    {
      "id": "example",
      "host": "example.com",
      "ports": [443],
      "methods": ["GET", "HEAD"]
    },
    {
      "id": "echo",
      "host": "postman-echo.com",
      "ports": [443],
      "methods": ["GET"],
      "pathPrefix": "/headers",
      "inject": {
        "header": "x-harbour-vault",
        "template": "{secret}",
        "secretEnv": "HARBOUR_CANARY_SECRET"
      }
    }
  ]
}
