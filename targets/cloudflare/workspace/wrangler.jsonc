{
	"$schema": "../../../node_modules/wrangler/config-schema.json",
	"name": "harbour-cloudflare-workspace-test",
	"compatibility_date": "2026-10-01",
	"r2_buckets": [{ "binding": "WORKSPACES", "bucket_name": "harbour-m1-be23-workspaces" }]
}
