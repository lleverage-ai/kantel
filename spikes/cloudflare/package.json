{
  "name": "@harbour/spike-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build:isolate": "bun scripts/build-isolate.ts",
    "types": "wrangler types --include-runtime=false src/worker-configuration.d.ts",
    "typecheck": "bun run build:isolate && tsc --noEmit -p .",
    "test": "bun test test",
    "deploy": "bun run build:isolate && wrangler deploy",
    "dev": "bun run build:isolate && wrangler dev"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "just-bash": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "typescript": "^7.0.2",
    "wrangler": "4.153.0"
  }
}
