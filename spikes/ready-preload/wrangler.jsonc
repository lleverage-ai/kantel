{
	// #17 option (a) measurement spike. Temporary: every resource is named harbour-ready-spike and is deleted after the
	// run (see README.md). It shares nothing with the production `harbour` Worker: no routes, bindings or storage.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "harbour-ready-spike",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	"observability": { "enabled": true },
	"rules": [{ "type": "Text", "globs": ["**/*.bundle.txt"], "fallthrough": true }],
	"r2_buckets": [{ "binding": "WORKSPACES", "bucket_name": "harbour-ready-spike" }],
	"worker_loaders": [{ "binding": "LOADER" }],
	"durable_objects": {
		"bindings": [
			{ "name": "SESSION", "class_name": "SessionDO" },
			{ "name": "WORKSPACE", "class_name": "WorkspaceDO" },
			{ "name": "POOL", "class_name": "PoolDO" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO", "WorkspaceDO", "PoolDO"] }]
}
